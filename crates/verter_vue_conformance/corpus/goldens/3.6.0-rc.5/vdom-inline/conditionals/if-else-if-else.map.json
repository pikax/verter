    "<script setup>\nimport { ref } from \"vue\"\n\nconst status = ref(\"loading\")\n</script>\n\n<template>\n  <p v-if=\"status === 'loading'\">Loading</p>\n  <p v-else-if=\"status === 'error'\">Failed</p>\n  <p v-else>Done: {{ status }}</p>\n</template>\n"
