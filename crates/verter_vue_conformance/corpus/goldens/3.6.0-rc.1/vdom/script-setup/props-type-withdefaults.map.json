  "sourcesContent": [
    "<script setup lang=\"ts\">\nimport type { Item } from \"../../support/types\"\n\nconst props = withDefaults(\n  defineProps<{\n    item: Item\n    size?: \"sm\" | \"lg\"\n    tags?: string[]\n  }>(),\n  { size: \"sm\", tags: () => [] },\n)\nconst emit = defineEmits<{\n  pick: [item: Item]\n  close: []\n}>()\n</script>\n\n<template>\n  <div @click=\"emit('pick', props.item)\">\n    {{ item.name }} ({{ size }}) {{ tags.length }}\n  </div>\n</template>\n"
  ],
