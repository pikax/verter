  "clientModule": "import 'svelte/internal/disclose-version'; import * as $ from 'svelte/internal/client'; var root = $.from_html(`<button></button>`); export default function combined_effect($$anchor) {let id = $.state('a'); let c = $.state('b'); let s = $.state('color:red'); var button = root(); $.template_effect(() => {$.set_attribute(button, 'id', $.get(id)); $.set_class(button, 1, $.clsx($.get(c))); $.set_style(button, $.get(s));}); $.delegated('click', button, () => {$.set(id, $.get(id) + '!'); $.set(c, $.get(c) + '!'); $.set(s, $.get(s) + '!');}); $.append($$anchor, button);} $.delegate(['click']);",
