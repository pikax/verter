{"version":3,"file":"App.vue","names":[],"sources":["App.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport Card from './Card.vue'\nimport Panel from './Panel.vue'\nimport Row from './Row.vue'\n</script>\n<template>\n  <Card>\n    <template #header=\"{ title }\">\n      <Row>{{ title }}</Row>\n    </template>\n    <template #default>\n      <Panel />\n      leading text\n    </template>\n  </Card>\n</template>"],"mappings":"AACA,4B,GAA4B,C;AAC5B,8B,GAA8B,C;AAC9B,0B,GAA0B,C;A;;AAH1B;AAAwB;AACK;AACE;AACJ;AAC3B;;;;;;;;A,EACU;AACV;AACA,IAAI,IAAW,MAAM,E,wIAAa;AAClC,WAAW,CAAE,OAAO,CAAE;AACtB,I,WAAI,GAAW;AACf,IAAI,IAAW,OAAO,EAAC;AACvB;AACA,M,EAAM,Y,EAAY;AAClB,IAAI,GAAW;AACf;A,G;8G,G;6G,G;8G,E,GANW,YAAJ,GAGA,KAAQ,YAHT;uHAGA;0GALJ;qI;;;;;;;;;;;;;;;;;;;;;;A"}