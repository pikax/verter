{
  "name": "rev11-l1-soak",
  "kind": "soak",
  "description": "The long-churn soak: 100 tranches of 100 editor actions (10,000 actions, every lifecycle class, both typed refusal classes) in normal and pressure modes through the public host routes, retention sampled every 25 actions with capture off, judged by the runner's action, result and publication inventories, answer rules, opening-window envelope and close/teardown drain; process memory and wall time beside it on the benchmark machine.",
  "modes": ["normal", "pressure"],
  "noise": [
    "docs/contributing/semantic-benchmark.md#verdicts",
    "docs/contributing/semantic-benchmark.md#schedule"
  ],
  "soak": {
    "runner": "verter-soak",
    "build": {
      "package": "verter_bench",
      "bin": "verter-soak",
      "profile": "release",
      "features": ["soak-support"]
    },
    "tranches": 100,
    "actionsPerTranche": 100,
    "minDistinctQueries": 3000,
    "sampleEvery": 25,
    "envelopeActions": 2000,
    "workloads": {
      "normal": {
        "actions": 10000,
        "distinctQueries": 6200,
        "digest": "7738eb53c16411bb0d3a1072e6cfdd26c96ecda21f6cfabee11e816f929389bf"
      },
      "pressure": {
        "actions": 10000,
        "distinctQueries": 5800,
        "digest": "ab9604943c222e883fe50f3ad391d3a05035ed90283bcebddb52bada39da1676"
      }
    },
    "smoke": {
      "normal": {
        "tranches": 1,
        "digest": "44ed5e79c72d5280539cfc4d7257db18f8f0d97cd031caf886c36ae194e17255"
      },
      "pressure": {
        "tranches": 1,
        "digest": "5af81e6e8ff3db6704377e47b2128b39a14d03c8788d10adb5a7c1d07630b496"
      }
    },
    "binding": {
      "smoke": "targeted-domain",
      "full": "bench-m3"
    },
    "controls": {
      "runner": "verter-soak --controls",
      "names": [
        "retained-key-leak",
        "omitted-workload-class",
        "omitted-cancellation",
        "fake-overlap",
        "wrong-project-reversion",
        "missing-summary",
        "unexpected-skip",
        "unfrozen-fixture"
      ]
    }
  },
  "requiredCells": [
    {
      "mode": "normal",
      "metrics": [
        "verdict",
        "controls",
        "failures",
        "actions",
        "samples",
        "closedRetainedBytes",
        "finalRetainedBytes"
      ]
    },
    {
      "mode": "pressure",
      "metrics": [
        "verdict",
        "failures",
        "actions",
        "samples",
        "closedRetainedBytes",
        "finalRetainedBytes",
        "surgeRefusalsPressure",
        "surgeRefusalsOversized",
        "surgeRefusalsActive",
        "surgeActivePeakBytes"
      ]
    },
    {
      "mode": "normal",
      "benchM3Only": true,
      "metrics": ["wallMs", "peakRssBytes", "processTreePeakBytes"]
    },
    {
      "mode": "pressure",
      "benchM3Only": true,
      "metrics": ["wallMs", "peakRssBytes", "processTreePeakBytes"]
    }
  ]
}
