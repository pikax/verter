{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authority amendment chain head",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "baseline_authority_sha256", "current_authority_sha256", "generation", "last_amendment_id", "last_amendment_sha256"],
  "properties": {
    "schema": { "const": 2 },
    "baseline_authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "current_authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generation": { "type": "integer", "minimum": 0 },
    "last_amendment_id": { "type": "string", "pattern": "^(?:|AMD-[A-Z0-9-]+)$" },
    "last_amendment_sha256": { "type": "string", "pattern": "^(?:|[0-9a-f]{64})$" }
  }
}
