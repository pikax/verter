{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authenticated next-cycle obligation closure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "receipt_id", "node_id", "candidate_sha", "candidate_tree", "review_profile", "lens", "severity", "fingerprint", "owner", "obligation", "status", "closed_at", "closure_evidence"],
  "properties": {
    "schema": { "const": 1 },
    "type": { "const": "next-cycle-obligation-closure" },
    "receipt_id": { "type": "string", "pattern": "^NEXT-[A-Z0-9-]+$" },
    "node_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "review_profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "lens": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "severity": { "const": "P2" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "owner": { "type": "string", "minLength": 1 },
    "obligation": { "type": "string", "minLength": 1 },
    "status": { "const": "CLOSED" },
    "closed_at": { "type": "string", "format": "date-time" },
    "closure_evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
