{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable legacy receipt manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt"],
  "properties": {
    "schema": { "const": 2 },
    "receipt": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["node_id", "file_sha256", "payload_sha256"], "properties": {
      "node_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
      "file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    } } }
  }
}
