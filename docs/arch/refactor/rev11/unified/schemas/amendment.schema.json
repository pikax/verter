{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable authority amendment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "amendment_id", "ratified_by", "ratification_receipt_sha256", "previous_amendment_sha256", "before_authority_sha256", "after_authority_sha256", "before_generation", "after_generation", "changed_paths", "changed_nodes", "impact_closure", "invalidated_receipts", "payload_sha256"],
  "properties": {
    "schema": { "const": 2 }, "type": { "const": "authority-amendment" },
    "amendment_id": { "type": "string", "pattern": "^AMD-[A-Z0-9-]+$" },
    "ratified_by": { "type": "string", "minLength": 1 },
    "ratification_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "previous_amendment_sha256": { "type": "string", "pattern": "^(?:|[0-9a-f]{64})$" },
    "before_authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "after_authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "before_generation": { "type": "integer", "minimum": 0 },
    "after_generation": { "type": "integer", "minimum": 1 },
    "changed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "changed_nodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" } },
    "impact_closure": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" } },
    "invalidated_receipts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*:[0-9a-f]{64}$" } },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
