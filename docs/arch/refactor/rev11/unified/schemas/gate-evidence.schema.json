{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate-bound gate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "execution_custody", "evidence_id", "node_id", "gate_profile", "scope", "candidate_sha", "candidate_tree", "integration_sha", "integration_tree", "commands", "executed_work", "unexpected_skips", "terminal_summary", "result_path", "result_sha256", "started_at", "completed_at", "executed_by", "payload_sha256"],
  "properties": {
    "schema": { "const": 2 }, "type": { "const": "gate-evidence" },
    "execution_custody": { "const": "programctl-gate-run/v1" },
    "evidence_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "node_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
    "gate_profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "scope": { "type": "string", "enum": ["candidate", "integration"] },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "integration_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "integration_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "commands": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "executed_work": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "unexpected_skips": { "const": 0 }, "terminal_summary": { "const": "PASS" },
    "result_path": { "type": "string", "pattern": "^gate-results/[A-Za-z0-9._/-]+$" },
    "result_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "started_at": { "type": "string", "format": "date-time" }, "completed_at": { "type": "string", "format": "date-time" },
    "executed_by": { "type": "string", "minLength": 1 },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
