{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable candidate finalization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "finalization_id", "node_id", "lease_receipt", "dispatch_receipt", "base_sha", "base_tree", "candidate_start_sha", "candidate_start_tree", "candidate_ref", "candidate_sha", "candidate_tree", "candidate_worktree", "authority_sha256", "changed_paths", "finalized_at", "finalized_by", "payload_sha256"],
  "properties": {
    "schema": { "const": 2 }, "type": { "const": "candidate-finalization" },
    "finalization_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }, "node_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
    "lease_receipt": { "type": "string", "pattern": "^[A-Za-z0-9._-]+:[0-9a-f]{64}$" }, "dispatch_receipt": { "type": "string", "pattern": "^[A-Za-z0-9._-]+:[0-9a-f]{64}$" },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "base_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_start_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "candidate_start_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_ref": { "type": "string", "pattern": "^refs/[A-Za-z0-9._/-]+$" }, "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "candidate_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_worktree": { "type": "string", "minLength": 1 }, "authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "changed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" } },
    "finalized_at": { "type": "string", "format": "date-time" }, "finalized_by": { "type": "string", "minLength": 1 },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
