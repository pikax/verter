{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Closed legacy acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "node_id", "verdict", "accepted_sha", "accepted_tree", "candidate_sha", "candidate_tree", "integration_sha", "integration_tree", "charter_sha256", "source_ledger_sha256", "predecessors", "gate_evidence", "review_evidence", "payload_sha256"],
  "properties": {
    "schema": { "const": 2 },
    "type": { "const": "legacy-accepted" },
    "node_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
    "verdict": { "const": "ACCEPTED" },
    "accepted_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "accepted_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "integration_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "integration_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "charter_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_ledger_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "predecessors": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" } },
    "gate_evidence": { "type": "string", "minLength": 1 },
    "review_evidence": { "type": "string", "minLength": 1 },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
