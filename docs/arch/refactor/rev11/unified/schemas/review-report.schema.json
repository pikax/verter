{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted reviewer structured report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "node_id", "candidate_sha", "candidate_tree", "reviewer", "lens", "verdict", "findings"],
  "properties": {
    "schema": { "const": 1 },
    "node_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewer": { "type": "string", "minLength": 1 }, "lens": { "type": "string", "minLength": 1 },
    "verdict": { "const": "PASS" },
    "findings": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["severity", "fingerprint", "owner", "status"],
        "allOf": [
          {
            "if": { "properties": { "severity": { "const": "P2" } }, "required": ["severity"] },
            "then": { "required": ["class_wide_sweep", "next_cycle_obligation", "next_cycle_receipt", "authorization_binding"], "properties": { "status": { "const": "AUTHORIZED_DEFERRED" } } },
            "else": { "properties": { "status": { "const": "CLOSED" } } }
          }
        ],
        "properties": {
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "owner": { "type": "string", "minLength": 1 },
          "class_wide_sweep": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "next_cycle_obligation": { "type": "string", "minLength": 1 },
          "next_cycle_receipt": { "type": "string", "pattern": "^NEXT-[A-Z0-9-]+:[0-9a-f]{64}$" },
          "authorization_binding": { "type": "string", "pattern": "^finding-disposition:[0-9a-f]{64}$" },
          "status": { "enum": ["CLOSED", "AUTHORIZED_DEFERRED"] }
        }
      }
    }
  }
}
