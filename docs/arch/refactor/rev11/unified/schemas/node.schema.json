{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "Unified DAG node",
  "type": "object",
  "required": [
    "id",
    "name",
    "predecessors",
    "conditional_predecessors",
    "phase",
    "train",
    "product",
    "kind",
    "semantic_role",
    "class",
    "owner",
    "conflict_domains",
    "resource_class",
    "gate_profile",
    "review_profile",
    "implementation_effort_min",
    "implementation_effort_default",
    "review_effort_min",
    "review_effort_default",
    "verification_effort_min",
    "verification_effort_default",
    "confirmation_effort_min",
    "confirmation_effort_default",
    "dispatchable",
    "optional",
    "release_gating",
    "source_refs",
    "external_requirements",
    "activation_gate",
    "charter",
    "size",
    "max_production_loc",
    "max_production_files",
    "max_related_packages",
    "rescope_loc",
    "rescope_files",
    "rescope_unrelated_packages"
  ],
  "allOf": [
    {
      "if": { "properties": { "initial_state": { "const": "ACCEPTED" } }, "required": ["initial_state"] },
      "then": { "properties": { "semantic_role": { "const": "history" }, "review_profile": { "const": "history" }, "dispatchable": { "const": false } } }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "predecessors": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" }
    },
    "conditional_predecessors": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*:when-opened$" }
    },
    "phase": {
      "type": "string"
    },
    "train": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "semantic_role": {
      "type": "string",
      "enum": ["delivery", "convergence", "history"]
    },
    "class": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "conflict_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "resource_class": {
      "type": "string"
    },
    "gate_profile": {
      "type": "string"
    },
    "review_profile": {
      "type": "string"
    },
    "implementation_effort_min": { "enum": ["low", "medium", "high"] },
    "implementation_effort_default": { "enum": ["low", "medium", "high"] },
    "review_effort_min": { "enum": ["low", "medium", "high"] },
    "review_effort_default": { "enum": ["low", "medium", "high"] },
    "verification_effort_min": { "enum": ["low", "medium", "high"] },
    "verification_effort_default": { "enum": ["low", "medium", "high"] },
    "confirmation_effort_min": { "enum": ["low", "medium", "high"] },
    "confirmation_effort_default": { "enum": ["low", "medium", "high"] },
    "dispatchable": {
      "type": "boolean"
    },
    "optional": {
      "type": "boolean"
    },
    "release_gating": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "external_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "activation_gate": {
      "type": "string"
    },
    "charter": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "max_production_loc": {
      "type": "integer"
    },
    "max_production_files": {
      "type": "integer"
    },
    "max_related_packages": {
      "type": "integer"
    },
    "rescope_loc": {
      "type": "integer"
    },
    "rescope_files": {
      "type": "integer"
    },
    "rescope_unrelated_packages": {
      "type": "integer"
    },
    "initial_state": {
      "type": "string",
      "enum": ["ACCEPTED", "IN_FLIGHT", "RESCOPE_REQUIRED", "SUPERSEDED"]
    }
  }
}
