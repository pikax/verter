{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable dispatch packet receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "dispatch_id", "node_id", "lease_receipt", "base_sha", "base_tree", "candidate_start_sha", "candidate_start_tree", "candidate_ref", "candidate_worktree", "authority_sha256", "charter_sha256", "conflict_domains", "scope_path_roots", "scope_symbols", "packet_path", "packet_sha256", "dispatched_at", "dispatched_by", "payload_sha256"],
  "properties": {
    "schema": { "const": 2 }, "type": { "const": "dispatch-receipt" },
    "dispatch_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "node_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
    "lease_receipt": { "type": "string", "pattern": "^[A-Za-z0-9._-]+:[0-9a-f]{64}$" },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "base_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_start_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "candidate_start_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_ref": { "type": "string", "pattern": "^refs/[A-Za-z0-9._/-]+$" }, "candidate_worktree": { "type": "string", "minLength": 1 },
    "authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "charter_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "conflict_domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
    "scope_path_roots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "scope_symbols": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "packet_path": { "type": "string", "pattern": "^dispatch-packets/[A-Za-z0-9._/-]+\\.md$" }, "packet_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dispatched_at": { "type": "string", "format": "date-time" }, "dispatched_by": { "type": "string", "minLength": 1 },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
