{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit-only preactivation ORC0 history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "acceptance_eligible", "disposition", "node_id", "round_id", "lease_id", "lease_receipt_sha256", "finalization_id", "finalization_receipt_sha256", "candidate_sha", "candidate_tree", "minimum_successor_round_ordinal", "preservation"],
  "properties": {
    "schema": { "const": 1 }, "type": { "const": "trusted-local-preactivation-history" }, "acceptance_eligible": { "const": false }, "disposition": { "const": "REJECTED_AUDIT_ONLY" },
    "node_id": { "const": "ORC0" }, "round_id": { "const": "ORC0-R1" }, "lease_id": { "type": "string", "minLength": 1 }, "lease_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "finalization_id": { "type": "string", "minLength": 1 }, "finalization_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "candidate_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "minimum_successor_round_ordinal": { "type": "integer", "minimum": 2 }, "preservation": { "type": "string", "minLength": 1 }
  }
}
