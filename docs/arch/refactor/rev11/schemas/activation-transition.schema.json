{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable authority activation transition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "transition_id", "from_state", "to_state", "payload_sha256"],
  "properties": {
    "schema": { "type": "integer" },
    "type": { "const": "activation-transition" },
    "transition_id": { "type": "string" },
    "from_state": { "type": "string", "enum": ["DORMANT", "ACTIVE"] },
    "to_state": { "const": "ACTIVE" },
    "j1_receipt": { "type": "string" },
    "orc0_receipt": { "type": "string" },
    "orc0_landing": { "type": "string" },
    "candidate_sha": { "type": "string" },
    "candidate_tree": { "type": "string" },
    "candidate_ref": { "type": "string" },
    "canonical_ref": { "type": "string" },
    "canonical_sha": { "type": "string" },
    "canonical_tree": { "type": "string" },
    "activation_authorization": { "type": "string" },
    "authority_sha256": { "type": "string" },
    "activated_by": { "type": "string" },
    "activated_at": { "type": "string" },
    "previous_activation_transition": { "type": "string" },
    "authority_amendment": { "type": "string" },
    "activation_predecessor_authority_sha256": { "type": "string" },
    "before_authority_sha256": { "type": "string" },
    "after_authority_sha256": { "type": "string" },
    "before_generation": { "type": "integer" },
    "after_generation": { "type": "integer" },
    "reactivated_by": { "type": "string" },
    "ratification_receipt_sha256": { "type": "string" },
    "reactivated_at": { "type": "string" },
    "payload_sha256": { "type": "string" }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "type",
        "transition_id",
        "from_state",
        "to_state",
        "j1_receipt",
        "orc0_receipt",
        "activation_authorization",
        "authority_sha256",
        "activated_by",
        "activated_at",
        "payload_sha256"
      ],
      "properties": {
        "schema": { "const": 2 },
        "type": { "const": "activation-transition" },
        "transition_id": { "type": "string", "pattern": "^ACT-[A-Z0-9-]+$" },
        "from_state": { "const": "DORMANT" },
        "to_state": { "const": "ACTIVE" },
        "j1_receipt": { "type": "string", "pattern": "^J1-LANDED-GRANDFATHERED:[0-9a-f]{64}$" },
        "orc0_receipt": { "type": "string", "pattern": "^ORC0:[0-9a-f]{64}$" },
        "orc0_landing": { "type": "string", "pattern": "^ORC0-LANDING:[0-9a-f]{64}$" },
        "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "candidate_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "candidate_ref": { "type": "string", "pattern": "^refs/heads/.+$" },
        "canonical_ref": { "type": "string", "pattern": "^refs/heads/.+$" },
        "canonical_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "canonical_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "activation_authorization": {
          "type": "string",
          "pattern": "^maintainer_unified_v2_activation:[0-9a-f]{64}$"
        },
        "authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "activated_by": { "type": "string", "minLength": 1 },
        "activated_at": { "type": "string", "format": "date-time" },
        "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "type",
        "transition_id",
        "from_state",
        "to_state",
        "previous_activation_transition",
        "authority_amendment",
        "activation_predecessor_authority_sha256",
        "before_authority_sha256",
        "after_authority_sha256",
        "before_generation",
        "after_generation",
        "reactivated_by",
        "ratification_receipt_sha256",
        "reactivated_at",
        "payload_sha256"
      ],
      "properties": {
        "schema": { "const": 3 },
        "type": { "const": "activation-transition" },
        "transition_id": { "type": "string", "pattern": "^ACT-[A-Z0-9-]+$" },
        "from_state": { "const": "ACTIVE" },
        "to_state": { "const": "ACTIVE" },
        "previous_activation_transition": {
          "type": "string",
          "pattern": "^ACT-[A-Z0-9-]+:[0-9a-f]{64}$"
        },
        "authority_amendment": { "type": "string", "pattern": "^AMD-[A-Z0-9-]+:[0-9a-f]{64}$" },
        "activation_predecessor_authority_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "before_authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "after_authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "before_generation": { "type": "integer", "minimum": 0 },
        "after_generation": { "type": "integer", "minimum": 1 },
        "reactivated_by": { "type": "string", "minLength": 1 },
        "ratification_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reactivated_at": { "type": "string", "format": "date-time" },
        "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  ]
}
