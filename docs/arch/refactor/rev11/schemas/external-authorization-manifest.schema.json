{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable external authorization allowlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authorization"],
  "properties": {
    "schema": { "const": 2 },
    "authorization": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["node_id", "authorization", "granted_by", "ratification_path", "ratification_receipt_sha256", "expires_at", "grant_mode", "directive_scope"], "properties": {
      "node_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
      "authorization": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "granted_by": { "type": "string", "minLength": 1 },
      "ratification_path": { "type": "string", "pattern": "^(?:authority/state/ratification-receipts/[A-Za-z0-9._/-]+|sources/maintainer-directive-2026-08-27\\.md)$" },
      "ratification_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "expires_at": { "type": "string", "minLength": 1 },
      "grant_mode": { "type": "string", "enum": ["EXTERNAL_CUSTODY", "MAINTAINER_DIRECTIVE_FINALIZED_CANDIDATE"] },
      "directive_scope": { "type": "string" }
    } } }
  }
}
