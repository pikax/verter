{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conflict domain catalog",
  "type": "object", "additionalProperties": false, "required": ["schema", "domain"],
  "properties": { "schema": { "const": 2 }, "domain": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "path_roots", "symbols", "description"], "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "path_roots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "symbols": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "description": { "type": "string", "minLength": 1 }
  } } } }
}
