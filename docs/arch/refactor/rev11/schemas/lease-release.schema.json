{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable lease release marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "release_id", "lease_receipt", "holder", "released_at", "payload_sha256"],
  "properties": {
    "schema": { "const": 2 },
    "type": { "const": "lease-release" },
    "release_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "lease_receipt": { "type": "string", "pattern": "^[A-Za-z0-9._-]+:[0-9a-f]{64}$" },
    "holder": { "type": "string", "minLength": 1 },
    "released_at": { "type": "string", "format": "date-time" },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
