{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed exact legacy architecture transfer map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog", "source_commit", "source_tree", "historical_evidence_prefix", "transfer"],
  "properties": {
    "schema": { "const": 1 },
    "catalog": { "const": "legacy-arch-transfer-map" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "historical_evidence_prefix": { "const": "docs/arch/architecture-lock/ledger/" },
    "transfer": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "blob_sha", "targets"],
      "properties": {
        "path": { "type": "string", "pattern": "^docs/arch/" },
        "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" } },
        "relocations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    } }
  }
}
