{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authority-bound canonical Git history rewrites",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rewrite"],
  "properties": {
    "schema": { "const": 1 },
    "rewrite": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "receipt_id", "original_sha", "original_tree", "replacement_sha", "replacement_tree", "replacement_parent_sha", "canonical_integration_branch", "disposition"],
        "properties": {
          "node_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
          "receipt_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "original_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "original_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "replacement_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "replacement_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "replacement_parent_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "canonical_integration_branch": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "disposition": { "const": "AUTHORIZED_IDENTICAL_TREE_HISTORY_REWRITE" }
        }
      }
    }
  }
}
