{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable trusted-local review target manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "round_id", "lease_id", "node_id", "candidate_start_sha", "candidate_start_tree", "candidate_sha", "candidate_tree", "candidate_ref", "frozen_worktree", "mutation_policy"],
  "properties": {
    "schema": { "const": 1 },
    "type": { "const": "trusted-local-frozen-review-target" },
    "round_id": { "type": "string", "minLength": 1 },
    "lease_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "candidate_start_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_start_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_ref": { "type": "string", "pattern": "^refs/heads/" },
    "frozen_worktree": { "type": "string", "minLength": 1 },
    "mutation_policy": { "const": "read-only-until-round-invalidated" }
  }
}
