{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical direct-execution gate result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "execution_custody", "node_id", "scope", "candidate_sha", "candidate_tree", "integration_sha", "integration_tree", "executed_by", "commands", "started_at", "completed_at", "terminal_summary", "unexpected_skips", "results"],
  "properties": {
    "schema": { "const": 1 },
    "type": { "const": "gate-execution-result" },
    "execution_custody": { "const": "programctl-gate-run/v1" },
    "node_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
    "scope": { "enum": ["candidate", "integration"] },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "integration_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "integration_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "executed_by": { "type": "string", "minLength": 1 },
    "commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "terminal_summary": { "const": "PASS" },
    "unexpected_skips": { "const": 0 },
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["command", "argv", "status", "signal", "timed_out", "elapsed_ms", "stdout", "stderr", "stdout_sha256", "stderr_sha256"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "status": { "const": 0 }, "signal": { "const": "" }, "timed_out": { "const": false },
          "elapsed_ms": { "type": "integer", "minimum": 0 },
          "stdout": { "type": "string" }, "stderr": { "type": "string" },
          "stdout_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "stderr_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
