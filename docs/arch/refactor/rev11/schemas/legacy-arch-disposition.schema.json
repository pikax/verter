{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy architecture disposition catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog", "source_commit", "source_tree", "legacy_root", "authority_root", "exclude", "historical_evidence_prefix", "allowed_dispositions", "entry"],
  "properties": {
    "schema": { "const": 2 },
    "catalog": { "const": "legacy-arch-disposition" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "legacy_root": { "const": "docs/arch" },
    "authority_root": { "const": "docs/arch/refactor/rev11" },
    "exclude": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "const": "docs/arch/refactor/rev11/**" } },
    "historical_evidence_prefix": { "const": "docs/arch/architecture-lock/ledger/" },
    "allowed_dispositions": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["transferred_exact_source", "historical_evidence"] } },
    "entry": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "blob_sha", "disposition", "evidence_class", "source_sha256", "targets", "target_charter_digests", "replacement_sources", "replacement_sha256", "requirement_atoms", "delete_in_same_amendment", "rationale"],
      "properties": {
        "path": { "type": "string", "pattern": "^docs/arch/" },
        "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "disposition": { "enum": ["transferred_exact_source", "historical_evidence"] },
        "evidence_class": { "type": "string" },
        "source_sha256": { "type": "string", "pattern": "^(?:|[0-9a-f]{64})$" },
        "targets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" } },
        "target_charter_digests": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*:[0-9a-f]{64}$" } },
        "replacement_sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "replacement_sha256": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^.+:[0-9a-f]{64}$" } },
        "requirement_atoms": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" } },
        "delete_in_same_amendment": { "const": true },
        "rationale": { "type": "string", "minLength": 1 }
      }
    } }
  }
}
