{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One-time candidate-bound P2 finding disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "one_time", "node_id", "candidate_sha", "candidate_tree", "review_profile", "lens", "severity", "fingerprint", "owner", "class_wide_sweep", "expires_at", "next_cycle_obligation", "next_cycle_receipt"],
  "properties": {
    "schema": { "const": 1 },
    "type": { "const": "one-time-finding-disposition" },
    "one_time": { "const": true },
    "node_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "review_profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "lens": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "severity": { "const": "P2" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "owner": { "type": "string", "minLength": 1 },
    "class_wide_sweep": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "expires_at": { "type": "string", "format": "date-time" },
    "next_cycle_obligation": { "type": "string", "minLength": 1 },
    "next_cycle_receipt": { "type": "string", "pattern": "^NEXT-[A-Z0-9-]+:[0-9a-f]{64}$" }
  }
}
