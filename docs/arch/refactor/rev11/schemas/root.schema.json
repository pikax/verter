{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unified authority root",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "package", "state", "pinned_commit", "pinned_tree", "canonical_integration_branch", "entry_gate", "final_rev11_gate", "successor_promotion_gate", "modules", "generated_projection", "generated_views", "authority_rule"],
  "properties": {
    "schema": { "const": 4 },
    "revision": { "const": 11 },
    "package": { "const": "rev11-unified-dag-v2" },
    "state": { "type": "string", "enum": ["DORMANT", "ACTIVE"] },
    "pinned_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pinned_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "canonical_integration_branch": { "type": "string", "minLength": 1 },
    "entry_gate": { "const": "ORC0" },
    "final_rev11_gate": { "const": "L4" },
    "successor_promotion_gate": { "const": "BR0" },
    "modules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^dag/[a-z0-9-]+\\.toml$" } },
    "generated_projection": { "const": "../program-dag.toml" },
    "generated_views": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\.\\./generated/[A-Z-]+\\.(?:md|json)$" } },
    "authority_rule": { "type": "string", "minLength": 1 }
  }
}
