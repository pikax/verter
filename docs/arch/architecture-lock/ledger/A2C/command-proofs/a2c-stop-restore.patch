+    fn root_endpoint(&self) -> EndpointUndefinedFact {
+        let code = (self.flags.0 & SkeletonRegionFlags::ENDPOINT_MASK)
+            >> SkeletonRegionFlags::ENDPOINT_SHIFT;
+        match code {
+            SkeletonRegionFlags::ENDPOINT_DOES_NOT_CONTRIBUTE => EndpointUndefinedFact::Exact(
+                EndpointUndefinedDisposition::DoesNotContribute,
+            ),
+            SkeletonRegionFlags::ENDPOINT_CONTRIBUTES => {
+                EndpointUndefinedFact::Exact(EndpointUndefinedDisposition::Contributes)
+            }
+            code @ 2..=9 => EndpointUndefinedFact::Unknown(match code - 2 {
+                0 => CompletionUnknown::TargetCapacityExceeded,
+                1 => CompletionUnknown::UnresolvedBreakTarget,
+                2 => CompletionUnknown::UnresolvedContinueTarget,
+                3 => CompletionUnknown::LoopFlowRequired,
+                4 => CompletionUnknown::ConditionalFlowRequired,
+                5 => CompletionUnknown::FinallyInferenceFlowRequired,
+                6 => CompletionUnknown::UnsupportedWithStatement,
+                7 => CompletionUnknown::UnsupportedRecoveredSyntax,
+                _ => unreachable!(),
+            }),
+            _ => EndpointUndefinedFact::Unknown(CompletionUnknown::UnsupportedRecoveredSyntax),
+        }
+    }
+
+    #[cfg(test)]
+    fn endpoint_bits_are_zero(&self) -> bool {
+        self.flags.0 & SkeletonRegionFlags::ENDPOINT_MASK == 0
