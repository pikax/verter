+    }
+
+    fn set_root_endpoint(&mut self, fact: EndpointUndefinedFact) {
+        let code = match fact {
+            EndpointUndefinedFact::Exact(EndpointUndefinedDisposition::DoesNotContribute) => {
+                SkeletonRegionFlags::ENDPOINT_DOES_NOT_CONTRIBUTE
+            }
+            EndpointUndefinedFact::Exact(EndpointUndefinedDisposition::Contributes) => {
+                SkeletonRegionFlags::ENDPOINT_CONTRIBUTES
+            }
+            EndpointUndefinedFact::Unknown(reason) => {
+                SkeletonRegionFlags::ENDPOINT_UNKNOWN_BASE + reason as u8
+            }
+        };
+        self.flags.0 = (self.flags.0 & !SkeletonRegionFlags::ENDPOINT_MASK)
+            | (code << SkeletonRegionFlags::ENDPOINT_SHIFT);
+        debug_assert_eq!(self.flags.0 & 0b1110_0000, 0);
+    }
