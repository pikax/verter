+    fn advance_switch_patterns(mask: u8, case_pattern: u8) -> u8 {
+        let case_normal = case_pattern & 1 != 0;
+        let case_break = case_pattern & 2 != 0;
+        let mut advanced = 1_u8 << case_pattern;
+        for pattern in 0..4_u8 {
+            if mask & (1_u8 << pattern) == 0 {
+                continue;
+            }
+            let old_normal = pattern & 1 != 0;
+            let old_break = pattern & 2 != 0;
+            let next_normal = old_normal && case_normal;
+            let next_break = old_break || (old_normal && case_break);
+            let next = u8::from(next_normal) | (u8::from(next_break) << 1);
+            advanced |= 1_u8 << next;
+        }
+        advanced
+    }
