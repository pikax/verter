{
  "schema": "ErbCapabilityMatrix",
  "version": 1,
  "product": "ErbCapabilityMatrix",
  "node": "ERB0",
  "kind": "lock",
  "cellRule": "one cell per operation x host x profile; each cell names exactly one producer node and the acceptance items that prove it; an operation Verter does not provide is a truthful exclusion with no producer",
  "profiles": [
    "erb.erubi-1.13.1",
    "erb.erb-6.0.7"
  ],
  "hosts": [
    {
      "id": "verter-lsp.erb-document",
      "kind": "lsp-enhancement",
      "server": "crates/verter_lsp",
      "document": "erb",
      "tsgoOperations": [],
      "tsgoLimitations": [],
      "typescriptPlugin": "none",
      "note": "Verter serves the carrier document itself; there is no tsgo route and no TS projection"
    }
  ],
  "operations": [
    {
      "id": "scan.islands",
      "description": "Island boundaries, tag kinds and the first-%> close rule, per profile tag set",
      "layer": "parse",
      "producer": "ERB1",
      "acceptance": [
        "ERB1-AC1"
      ]
    },
    {
      "id": "scan.block-structure",
      "description": "Ruby block keyword pairing (if/else/end, do/end) through the boundary lexer",
      "layer": "parse",
      "producer": "ERB1",
      "acceptance": [
        "ERB1-AC3"
      ]
    },
    {
      "id": "scan.recovery",
      "description": "Recovery of unterminated islands with exact later offsets",
      "layer": "parse",
      "producer": "ERB1",
      "acceptance": [
        "ERB1-AC2"
      ]
    },
    {
      "id": "scan.incremental",
      "description": "Island-local rescan; fresh equals incremental",
      "layer": "parse",
      "producer": "ERB1",
      "acceptance": [
        "ERB1-AC5"
      ]
    },
    {
      "id": "compose.templated-html",
      "description": "HWC2 facts for text, holes and branches (shared with Liquid)",
      "layer": "compose",
      "producer": "ERBH1",
      "acceptance": [
        "ERBH1-AC1",
        "ERBH1-AC2",
        "ERBH1-AC3",
        "ERBH1-AC4"
      ]
    },
    {
      "id": "compose.regions",
      "description": "HTML, <style> and <script> composition through EMB0 with exact maps",
      "layer": "compose",
      "producer": "ERB2",
      "acceptance": [
        "ERB2-AC1",
        "ERB2-AC2",
        "ERB2-AC4"
      ]
    },
    {
      "id": "compose.hosts",
      "description": "Composition only for claimed hosts; <%# %> produces no HTML",
      "layer": "compose",
      "producer": "ERB2",
      "acceptance": [
        "ERB2-AC3"
      ]
    },
    {
      "id": "activation.inactive-zero-work",
      "description": "With erb off or inactive, the claimed hosts do zero ERB work",
      "layer": "activation",
      "producer": "ERB2",
      "acceptance": [
        "ERB2-AC5"
      ]
    },
    {
      "id": "op.block-pairs",
      "description": "Go-to-matching across block pairs",
      "layer": "lsp",
      "producer": "ERB3",
      "acceptance": [
        "ERB3-AC1"
      ]
    },
    {
      "id": "op.linked-editing",
      "description": "Linked editing of tag pairs; none for branch-split pairs",
      "layer": "lsp",
      "producer": "ERB3",
      "acceptance": [
        "ERB3-AC2"
      ]
    },
    {
      "id": "op.html-features",
      "description": "HTML completion and hover through HWCI0 over composed facts; nothing inside a Ruby island",
      "layer": "lsp",
      "producer": "ERB3",
      "acceptance": [
        "ERB3-AC3"
      ]
    },
    {
      "id": "op.semantic-tokens",
      "description": "Delimiter and trim-marker tokens; Ruby is one opaque class",
      "layer": "lsp",
      "producer": "ERB3",
      "acceptance": [
        "ERB3-AC4"
      ]
    },
    {
      "id": "op.structure",
      "description": "Public erb.structure block tree with completeness (DX1 row, generated MCP tool)",
      "layer": "public",
      "producer": "ERB3",
      "acceptance": [
        "ERB3-AC5"
      ]
    },
    {
      "id": "sinks.raw-output",
      "description": "Raw-output sink facts with context and unknown trust",
      "layer": "facts",
      "producer": "ERB4S",
      "acceptance": [
        "ERB4S-AC1",
        "ERB4S-AC2",
        "ERB4S-AC3"
      ]
    },
    {
      "id": "format.document",
      "description": "Formatting with Ruby bytes verbatim, block indentation, idempotence",
      "layer": "lsp",
      "producer": "ERB5F",
      "acceptance": [
        "ERB5F-AC1",
        "ERB5F-AC2",
        "ERB5F-AC3"
      ]
    },
    {
      "id": "lint.markup",
      "description": "Markup lint through the shared element view; holes are not absence; suppression",
      "layer": "lsp",
      "producer": "ERB4",
      "acceptance": [
        "ERB4-AC1",
        "ERB4-AC2",
        "ERB4-AC4"
      ]
    },
    {
      "id": "lint.percent-close-in-ruby-string",
      "description": "Diagnostic at the byte where a %> inside a Ruby string ends the tag",
      "layer": "lsp",
      "producer": "ERB4",
      "acceptance": [
        "ERB4-AC3"
      ]
    },
    {
      "id": "assists.structure",
      "description": "Template assists with declared applicability, whole-or-nothing edits and explain-branches",
      "layer": "lsp",
      "producer": "ERBA",
      "acceptance": [
        "ERBA-AC1",
        "ERBA-AC2",
        "ERBA-AC3",
        "ERBA-AC4"
      ]
    },
    {
      "id": "fragments.html-response",
      "description": "HRF1 fragment facts: conditional frames, holes, turbo-stream elements, invalidation",
      "layer": "facts",
      "producer": "HRF1-ERB",
      "acceptance": [
        "HRF1-ERB-AC1",
        "HRF1-ERB-AC2",
        "HRF1-ERB-AC3",
        "HRF1-ERB-AC4"
      ]
    },
    {
      "id": "client.registration",
      "description": "File associations, client manifest capability truth and CLI globs",
      "layer": "public",
      "producer": "ERBP0",
      "acceptance": [
        "ERBP0-AC1",
        "ERBP0-AC2",
        "ERBP0-AC3"
      ]
    },
    {
      "id": "qualification.conformance",
      "description": "Every admitted cell joined to a passing fixture; boundary corpus",
      "layer": "qualification",
      "producer": "ERB9",
      "acceptance": [
        "ERB9-AC1",
        "ERB9-AC2"
      ]
    },
    {
      "id": "qualification.incremental",
      "description": "Edit/revert equals fresh load; cancellation publishes no partial",
      "layer": "qualification",
      "producer": "ERB9",
      "acceptance": [
        "ERB9-AC3"
      ]
    },
    {
      "id": "qualification.exposure",
      "description": "Operations pass through the browser host, the native host and the editor lane",
      "layer": "qualification",
      "producer": "ERB9",
      "acceptance": [
        "ERB9-AC4"
      ]
    },
    {
      "id": "terminal.capability-truth",
      "description": "Generated ERB rows equal this matrix cell for cell and profile for profile",
      "layer": "terminal",
      "producer": "ERBT",
      "acceptance": [
        "ERBT-AC1"
      ]
    },
    {
      "id": "terminal.step-down",
      "description": "Zero work for capabilities a chosen competitor owns",
      "layer": "terminal",
      "producer": "ERBT",
      "acceptance": [
        "ERBT-AC2"
      ]
    },
    {
      "id": "terminal.mcp",
      "description": "Every DX1 row resolves to a generated MCP tool",
      "layer": "terminal",
      "producer": "ERBT",
      "acceptance": [
        "ERBT-AC3"
      ]
    },
    {
      "id": "terminal.docs",
      "description": "Every ERB docs example runs under DOC1",
      "layer": "terminal",
      "producer": "ERBT",
      "acceptance": [
        "ERBT-AC4"
      ]
    }
  ],
