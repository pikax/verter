  "exclusions": [
    {
      "id": "x.render",
      "operation": "render, compile or evaluate a template",
      "reason": "no runtime: no template is rendered, compiled or evaluated with data"
    },
    {
      "id": "x.ruby-execution",
      "operation": "run Ruby, Bundler, Rails, a gem or a generator",
      "reason": "no Ruby process ever runs; Ruby stays opaque past ERB1's boundary lexer"
    },
    {
      "id": "x.ruby-semantics",
      "operation": "Ruby completion, hover, definition, references, rename, types or diagnostics inside an island",
      "reason": "Ruby is opaque to Verter; Ruby LSP provides Ruby semantics in ERB (erb-coexistence.json)"
    },
    {
      "id": "x.tsgo",
      "operation": "any tsgo or TypeScript-provider route for an ERB document",
      "reason": "carrier documents have no TS projection"
    },
    {
      "id": "x.typescript-plugin",
      "operation": "any packages/typescript-plugin work",
      "reason": "carrier documents have no TS plugin route"
    },
    {
      "id": "x.non-html-host",
      "operation": "any operation on .js.erb, .text.erb or another non-HTML host",
      "reason": "never claimed (erb-activation-policy.json associations)"
    },
    {
      "id": "x.build",
      "operation": "build, bundle or asset-pipeline integration",
      "reason": "Verter does not compile ERB"
    },
    {
      "id": "x.facets-and-tag",
      "operation": "ComponentInfo facets or a FrameworkTag for ERB",
      "reason": "server-template carriers have no descriptor surface and no wire tag; partials are carrier facts"
    },
    {
      "id": "x.helper-semantics",
      "operation": "meaning of turbo-rails, stimulus-rails or Action View helper calls",
      "reason": "helper calls are opaque Ruby; a fact that needs one is unknown"
    }
  ],
  "consumers": [
    {
      "node": "STIM1E",
      "reads": "ERBH1 templated-HTML facts (compose.templated-html); never island text"
    },
    {
      "node": "HRF1-ERB",
      "reads": "ERBH1 and ERB2 facts; it is also the producer of fragments.html-response"
    },
    {
      "node": "FWA1",
      "reads": "erb-activation-policy.json and erb-version-lock.json as data"
    },
    {
      "node": "FCH1",
      "reads": "this matrix as data"
    },
    {
      "node": "ERB1G",
      "reads": "every product; owns the executable lock validator"
    }
  ],
