{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "reconciledAgainst", "reconciledOn", "rows"],
  "properties": {
    "schema": { "const": 1 },
    "reconciledAgainst": { "type": "string", "minLength": 1 },
    "reconciledOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "sourceRef",
          "applicability",
          "owner",
          "path",
          "subblocks",
          "acceptance"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$" },
          "role": { "enum": ["outcome", "consumer", "displaced"] },
          "sourceRef": { "type": "string", "minLength": 1 },
          "applicability": { "enum": ["required", "optional-channel"] },
          "owner": { "type": "string", "minLength": 1 },
          "path": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "subblocks": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z0-9]+-SB[0-9]+$" },
            "uniqueItems": true
          },
          "acceptance": { "type": "string" }
        }
      }
    }
  }
}
