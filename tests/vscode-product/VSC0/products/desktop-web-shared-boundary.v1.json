  "rules": [
    {
      "id": "shared-no-node-imports",
      "rule": "Common modules (presentation and pure tiers) cannot import Node builtins, use process.*, or call require()",
      "enforcement": "mechanical: re-derived from the live tree on every harness run (VSC0-AC2)"
    },
    {
      "id": "shared-no-module-load-work",
      "rule": "Common modules cannot execute work at module-load time; loading shared code with Node globals absent does not execute native provisioning",
      "enforcement": "runtime: bound to VSW1 (browser entrypoint and worker transport) as the owning test node; the import boundary above is the mechanical proxy enforced here"
    },
    {
      "id": "transport-desktop-owned",
      "rule": "The runtime vscode-languageclient/node import is desktop-owned (extension.ts today); a browser worker transport is added by VSW1 behind the same client-facing feature surface, never a fork of client logic",
      "enforcement": "mechanical: lspClient=value implies tier=desktop"
    },
    {
      "id": "type-elided-node-client-imports",
      "rule": "Type-position LanguageClient imports written as value imports (the eight view/decoration providers) keep their modules in the desktop tier until they become explicit import type; the browser cutover (VSW1) owns that conversion",
      "enforcement": "mechanical: value imports classify desktop regardless of type-only usage"
    },
    {
      "id": "no-class-change-by-moving-code",
      "rule": "A tier change is an owning-node port with its own evidence, never a relabel in this inventory",
      "enforcement": "contract: any tier delta in this product is drift against the live tree and is rejected"
    },
    {
      "id": "browser-is-distinct-product",
      "rule": "A browser sibling binds to producer services through this boundary; it never forks the extension, gains a second semantic/type/project engine, or copies the whole extension to claim parity (DX0 sections 3 and 8)",
      "enforcement": "contract: consumed by VSW0/VSW1 charters"
    }
  ],
