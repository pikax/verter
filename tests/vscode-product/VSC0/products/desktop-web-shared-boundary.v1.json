  "tiers": {
    "desktop": "Node activation tier: runtime Node builtin import, process.* usage, require(), or a runtime (non-type) vscode-languageclient/node import. Owns binary discovery, stdio LSP transport, child spawn, fs/os/env, tsdk staging, project-bound TypeScript loading.",
    "presentation": "Host-neutral VS Code API tier: imports the vscode API, no Node dependency. Tree views, webview panel, content providers, decorations surfaces, output channels, extension-side CSS intellisense service.",
    "pure": "No host imports: decision logic, state machines, launch-arg building, source-map decode model, CSS transpile/style structure."
  },
