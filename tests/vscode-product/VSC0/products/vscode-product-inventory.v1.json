  "lifecycle": {
    "policy": "Activation, recovery and teardown behavior captured in actual code; the owning implementation node is VSC1.",
    "rows": [
      {
        "id": "activation-gate",
        "behavior": "single-run activation gate: activate() runs the activation exactly once and deactivation resets it",
        "evidence": [
          "packages/vue-vscode/src/activationGate.ts",
          "packages/vue-vscode/src/activationSession.ts"
        ]
      },
      {
        "id": "deferred-features",
        "behavior": "analysis sidebar, watchers and Claude Code check register only on the server's $/verter/ready notification, never at activation",
        "evidence": ["packages/vue-vscode/src/extension.ts"]
      },
      {
        "id": "start-attempt-scope",
        "behavior": "one StartAttemptScope per language-server start attempt: failure disposes its own registrations; a spent attempt cannot hand the workspace an ownerless server",
        "evidence": [
          "packages/vue-vscode/src/startAttemptScope.ts",
          "packages/vue-vscode/src/extensionStartAttemptLifetime.spec.ts"
        ]
      },
      {
        "id": "heartbeat-watchdog",
        "behavior": "$/verter/heartbeat watchdog: 30s window after first heartbeat, 60s initial grace, auto-restart only over a server that actually started",
        "evidence": ["packages/vue-vscode/src/extension.ts"]
      },
      {
        "id": "restart-supervisor",
        "behavior": "bounded manual/automatic restart with give-up UX and orphaned type-provider pid cleanup",
        "evidence": ["packages/vue-vscode/src/restart.ts", "packages/vue-vscode/src/extension.ts"]
      },
      {
        "id": "mcp-child-lifetime",
        "behavior": "standalone verter-mcp HTTP child owned by the start attempt, --client-pid bound to the extension host, bounded crash respawn, port learned from the child's readiness record",
        "evidence": ["packages/vue-vscode/src/mcpServer.ts"]
      },
      {
        "id": "client-process-lifetime",
        "behavior": "LSP launch carries the extension-host pid so a hard host kill cannot orphan the server",
        "evidence": ["packages/vue-vscode/src/clientProcessLifetime.ts"]
      },
      {
        "id": "binary-discovery",
        "behavior": "findLspBinary precedence: e2e copy > verter.lspBinaryPath > newest cargo target (artifact-dev/debug/release, triple-qualified first) > bundled > PATH",
        "evidence": ["packages/vue-vscode/src/extension.ts", "packages/vue-vscode/src/rustHostTriple.ts"]
      },
      {
        "id": "startup-probe",
        "behavior": "VERTER_STARTUP_PROBE config drives timing markers and readiness/diagnostics tracking to a file",
        "evidence": ["packages/vue-vscode/src/startupProbe.ts"]
      },
      {
        "id": "plain-script-sync",
        "behavior": "plain TS/JS documents are synchronized to the LSP without registering competing editor features; plain-script LSP diagnostics are suppressed in the editor",
        "evidence": ["packages/vue-vscode/src/plainScriptDocumentSync.ts"]
      },
      {
        "id": "ts-plugin-carrier-store",
        "behavior": "$/verter/carrierStoreReady forwards the LSP-resolved carrier store dir to VS Code's own TypeScript server via _typescript.configurePlugin so plain .ts importing .vue reads the same store; refresh tokens advance only after a durable publication pass",
        "evidence": ["packages/vue-vscode/src/extension.ts", "packages/vue-vscode/src/typescriptPluginRefreshScheduler.ts"]
      }
    ]
  },
