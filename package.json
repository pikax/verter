{
  "name": "verter",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "pnpm --filter @verter/types --filter @verter/language-server --filter @verter/core test",
    "build": "pnpm run build:native && pnpm run build:wasm && pnpm run build:ts",
    "build:native": "pnpm --filter @verter/native build",
    "build:wasm": "pnpm --filter @verter/wasm build",
    "build:ts": "pnpm -r --filter './packages/**' --filter '!@verter/native' --filter '!@verter/wasm' --filter '!@verter/playground' --filter '!example' build",
    "build:playground": "pnpm --filter @verter/playground build",
    "watch": "pnpm --filter @verter/core --filter @verter/language-shared --filter @verter/language-server --filter verter-vscode --filter @verter/typescript-plugin watch",
    "dev-extension": "pnpm --filter @verter/language-server --filter verter-vscode watch",
    "update-all": "pnpm up -r -i -L",
    "build:package": "rollup -c rollup.config.js",
    "package": "cd extensions/vscode && npm install --omit=dev && npx shx mkdir -p node_modules/@verter && npx shx cp -r ../typescript-plugin node_modules/@verter/typescript-plugin && npx shx rm -r node_modules/@oxc-parser && npx vsce package",
    "copy-plugin": "npx shx mkdir -p extensions/vue-vscode/node_modules/@verter && npx shx cp -r extensions/typescript-plugin extensions/vue-vscode/node_modules/@verter/typescript-plugin",
    "clean": "pnpm -r exec npx shx rm -rf .turbo dist tsconfig.tsbuildinfo && npx shx rm -rf .turbo dist tsconfig.tsbuildinfo"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@hyrious/esbuild-plugin-commonjs": "^0.2.6",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.3",
    "esbuild-plugin-alias": "^0.2.1",
    "esbuild-plugin-alias-path": "^2.0.2",
    "glob": "^13.0.1",
    "json-diff": "^1.0.6",
    "rollup": "^4.57.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@vscode/vsce-sign",
      "esbuild",
      "keytar"
    ]
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c",
  "dependencies": {
    "@vue/compiler-core": "^3.5.27",
    "@vue/compiler-sfc": "^3.5.27",
    "oxfmt": "^0.28.0"
  }
}
