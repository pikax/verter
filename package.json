{
  "name": "verter",
  "version": "0.0.1-alpha.3",
  "private": true,
  "description": "Vue compiler and Language Server Protocol implementation",
  "keywords": ["vue", "compiler", "sfc", "typescript", "lsp"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pikax/verter"
  },
  "author": "pikax",
  "main": "index.js",
  "scripts": {
    "test": "pnpm --filter @verter/types --filter @verter/core test",
    "test:e2e": "pnpm --filter verter-vscode pretest:e2e && pnpm --filter verter-vscode test:e2e",
    "fmt": "oxfmt",
    "build": "pnpm run build:native && pnpm run build:lsp && pnpm run build:wasm && pnpm run build:ts",
    "build:native": "pnpm --filter @verter/native build",
    "build:lsp": "cargo build -p verter_lsp",
    "build:lsp:release": "cargo build -p verter_lsp --release",
    "build:wasm": "pnpm --filter @verter/wasm build",
    "build:ts": "pnpm -r --filter \"./packages/**\" --filter !@verter/native --filter !@verter/wasm --filter !@verter/playground --filter !example run build",
    "build:tsc": "cargo build -p verter_tsc",
    "build:tsc:release": "cargo build -p verter_tsc --release",
    "build:mcp": "cargo build -p verter_mcp",
    "build:mcp:release": "cargo build -p verter_mcp --release",
    "build:playground": "pnpm --filter @verter/playground build",
    "build:unplugin": "pnpm --filter @verter/unplugin build",
    "watch": "pnpm --filter @verter/core --filter @verter/language-shared --filter verter-vscode --filter @verter/typescript-plugin watch",
    "dev-extension": "pnpm run build:lsp && pnpm --filter @verter/language-shared --filter verter-vscode --filter @verter/typescript-plugin watch",
    "update-all": "pnpm up -r -i -L",
    "package": "cd extensions/vscode && npm install --omit=dev && npx shx mkdir -p node_modules/@verter && npx shx cp -r ../typescript-plugin node_modules/@verter/typescript-plugin && npx shx rm -r node_modules/@oxc-parser && npx vsce package",
    "copy-plugin": "npx shx mkdir -p extensions/vue-vscode/node_modules/@verter && npx shx cp -r extensions/typescript-plugin extensions/vue-vscode/node_modules/@verter/typescript-plugin",
    "clean": "pnpm -r exec npx shx rm -rf .turbo dist tsconfig.tsbuildinfo && npx shx rm -rf .turbo dist tsconfig.tsbuildinfo",
    "integration-test": "node scripts/integration-test/run.mjs",
    "integration-test:discover": "node scripts/integration-test/run.mjs --discover-local --discover-only",
    "integration-test:local": "node scripts/integration-test/run.mjs --discover-local --local-only",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview",
    "compare:ssr": "node scripts/ssr-baseline/compare.mjs",
    "profile:hotpath": "cargo run -p verter_bench --example profile_ast --release --features=hotpath",
    "profile:hotpath:alloc": "cargo run -p verter_bench --example profile_ast --release --features=hotpath-alloc",
    "profile:hotpath:full": "VERTER_PROFILE_FULL=1 cargo run -p verter_bench --example profile_ast --release --features=hotpath",
    "profile:hotpath:full:alloc": "VERTER_PROFILE_FULL=1 cargo run -p verter_bench --example profile_ast --release --features=hotpath-alloc",
    "prepare": "husky",
    "test:coverage": "vitest run --coverage"
  },
  "lint-staged": {
    "*.rs": "cargo fmt --check --",
    "*.{ts,js,mjs,cjs}": "oxfmt --check"
  },
  "dependencies": {
    "@vue/compiler-core": "3.6.0-beta.7",
    "@vue/compiler-sfc": "3.6.0-beta.7",
    "oxfmt": "^0.38.0"
  },
  "devDependencies": {
    "@hyrious/esbuild-plugin-commonjs": "^0.2.6",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.3",
    "esbuild-plugin-alias": "^0.2.1",
    "esbuild-plugin-alias-path": "^2.0.2",
    "glob": "^13.0.6",
    "json-diff": "^1.0.6",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@vscode/vsce-sign",
      "esbuild",
      "keytar"
    ]
  }
}
