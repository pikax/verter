{
  "name": "@verter/playground",
  "version": "0.0.1-beta.1",
  "private": true,
  "description": "Online playground for Verter's Vue and experimental Svelte compiler",
  "license": "MIT",
  "author": "pikax",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:workspace-deps": "pnpm --filter @verter/type-ir build && pnpm --filter @verter/proto build && pnpm --filter @verter/types build && pnpm --filter @verter/language-shared build && pnpm --filter @verter/native build:types",
    "sync:wasm": "npx shx cp ../wasm/wasm/verter_wasm_bg.wasm public/verter_wasm_bg.wasm",
    "build": "pnpm run build:workspace-deps && pnpm --filter @verter/unplugin build && pnpm --filter @verter/wasm build && pnpm run sync:wasm && pnpm --filter @verter/component-meta build && vite build",
    "preview": "vite preview",
    "test": "vitest --run --exclude '**/compiler.spec.ts'",
    "test:wasm": "vitest --run src/core/compiler.spec.ts",
    "test:e2e": "playwright test",
    "capture:wasm-fixtures": "node scripts/capture-wasm-carrier-fixtures.mjs",
    "check:wasm-fixtures": "node scripts/capture-wasm-carrier-fixtures.mjs --check",
    "generate:vue-language": "tsx scripts/generate-vue-language.ts"
  },
  "dependencies": {
    "@verter/component-meta": "workspace:*",
    "@verter/language-shared": "workspace:*",
    "@verter/types": "workspace:*",
    "@verter/wasm": "workspace:*",
    "fflate": "^0.8.3",
    "vue": "3.6.0-rc.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@shikijs/monaco": "^4.5.0",
    "@verter/unplugin": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/reactivity": "3.6.0-rc.5",
    "@vue/runtime-core": "3.6.0-rc.5",
    "@vue/runtime-dom": "3.6.0-rc.5",
    "@vue/shared": "3.6.0-rc.5",
    "csstype": "^3.2.3",
    "happy-dom": "^21.0.4",
    "monaco-editor-core": "^0.57.0",
    "shiki": "^4.5.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
