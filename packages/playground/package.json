{
  "name": "@verter/playground",
  "version": "0.0.1-beta.1",
  "private": true,
  "description": "Online playground for Verter Vue compiler",
  "license": "MIT",
  "author": "pikax",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @verter/unplugin build && pnpm --filter @verter/wasm build && pnpm --filter @verter/component-meta build && pnpm --filter @verter/types run build && pnpm --filter @verter/language-shared build && vite build",
    "preview": "vite preview",
    "test": "vitest --run --exclude '**/compiler.spec.ts' --exclude '**/tsService.spec.ts'",
    "test:e2e": "playwright test",
    "generate:vue-language": "tsx scripts/generate-vue-language.ts"
  },
  "dependencies": {
    "@verter/component-meta": "workspace:*",
    "@verter/language-shared": "workspace:*",
    "@verter/types": "workspace:*",
    "@verter/wasm": "workspace:*",
    "fflate": "^0.8.3",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@shikijs/monaco": "^4.1.0",
    "@verter/unplugin": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/reactivity": "^3.5.34",
    "@vue/runtime-core": "^3.5.34",
    "@vue/runtime-dom": "^3.5.34",
    "@vue/shared": "^3.5.34",
    "csstype": "^3.1.3",
    "happy-dom": "^20.9.0",
    "monaco-editor-core": "^0.55.1",
    "shiki": "^4.1.0",
    "tsx": "^4.22.3",
    "typescript": "6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
