{
  "name": "@verter/playground",
  "version": "0.0.1-beta.1",
  "private": true,
  "description": "Online playground for Verter Vue compiler",
  "license": "MIT",
  "author": "pikax",
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch-tsgo.mjs && vite",
    "build": "pnpm --filter @verter/unplugin build && pnpm --filter @verter/wasm build && pnpm --filter @verter/component-meta build && pnpm --filter @verter/types run build && node scripts/fetch-tsgo.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest --run --exclude '**/compiler.spec.ts' --exclude '**/sourceMapMapper.spec.ts' --exclude '**/tsService.spec.ts'",
    "test:e2e": "playwright test",
    "generate:vue-language": "tsx scripts/generate-vue-language.ts"
  },
  "dependencies": {
    "@verter/component-meta": "workspace:*",
    "@verter/types": "workspace:*",
    "@verter/wasm": "workspace:*",
    "fflate": "^0.8.2",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@shikijs/monaco": "^4.0.2",
    "@verter/unplugin": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.5",
    "happy-dom": "^20.8.3",
    "monaco-editor-core": "^0.55.1",
    "shiki": "^4.0.2",
    "tsx": "^4.21.0",
    "typescript": "6.0.0-beta",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
