{
  "name": "@verter/svelte-jsx",
  "version": "0.0.1-beta.1",
  "description": "Verter-owned, module-scoped JSX namespace for Svelte IDE projections, with native Svelte 5 Component adaptation, official-derived element attributes, a child-only projection adapter, and dedicated SVG and MathML entrypoints. Types-only, no runtime JS.",
  "keywords": [
    "jsx",
    "svelte",
    "tsx",
    "verter"
  ],
  "homepage": "https://verterjs.dev/",
  "license": "MIT",
  "author": "pikax",
  "repository": {
    "type": "git",
    "url": "https://github.com/pikax/verter"
  },
  "files": [
    "jsx-runtime.d.ts",
    "jsx-dev-runtime.d.ts",
    "svg/jsx-runtime.d.ts",
    "svg/jsx-dev-runtime.d.ts",
    "mathml/jsx-runtime.d.ts",
    "mathml/jsx-dev-runtime.d.ts",
    "readme.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "jsx-runtime.d.ts",
  "exports": {
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-dev-runtime.d.ts"
    },
    "./svg/jsx-runtime": {
      "types": "./svg/jsx-runtime.d.ts"
    },
    "./svg/jsx-dev-runtime": {
      "types": "./svg/jsx-dev-runtime.d.ts"
    },
    "./mathml/jsx-runtime": {
      "types": "./mathml/jsx-runtime.d.ts"
    },
    "./mathml/jsx-dev-runtime": {
      "types": "./mathml/jsx-dev-runtime.d.ts"
    }
  },
  "scripts": {
    "test": "echo \"no tests — @verter/svelte-jsx is a hand-written types-only shim (byte-pinned by the Rust freshness test)\""
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
