{
  "extends": "./tsconfig.json",
  "include": ["./e2e", "./src/startupOptimizations.ts", "./src/e2eEnv.ts"],
  "exclude": [
    "./e2e/fixtures",
    "./e2e/dx/vitest.config.ts",
    "./e2e/dx/**/*.unit.test.ts"
  ],
  "compilerOptions": {
    "outDir": "./out-test",
    "rootDir": ".",
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["mocha", "node"],
    "resolveJsonModule": true
  }
}
