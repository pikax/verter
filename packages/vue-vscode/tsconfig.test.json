{
  "extends": "./tsconfig.json",
  "include": [
    "./e2e",
    "./src/startupOptimizations.ts",
    "./src/e2eEnv.ts",
    "./src/sharedTsgoLaunch.ts",
    "./src/runSummaryOracle.ts"
  ],
  "exclude": [
    "./e2e/fixtures",
    "./e2e/dx/vitest.config.ts",
    "./e2e/dx/**/*.unit.test.ts"
  ],
  "compilerOptions": {
    "outDir": "./out-test",
    "rootDir": ".",
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    // The pinned TypeScript (6.0.x) turns the legacy `moduleResolution: node`
    // (node10) into a hard error; this is the documented opt-in that keeps it a
    // deprecation. The classic node10 resolution is still what the Mocha E2E
    // (commonjs `out-test`) build wants — migrating it to bundler/node16 is a
    // separate change.
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["mocha", "node"],
    "resolveJsonModule": true
  }
}
