{
  "extends": "./tsconfig.json",
  "include": ["./e2e"],
  "compilerOptions": {
    "outDir": "./out-test",
    "rootDir": ".",
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["mocha", "node"],
    "resolveJsonModule": true
  }
}
