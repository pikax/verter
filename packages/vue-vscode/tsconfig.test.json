{
  "extends": "./tsconfig.json",
  "include": [
    "./e2e",
    "./src/startupOptimizations.ts",
    "./src/e2eEnv.ts",
    "./src/e2eProviderAttestation.ts",
    "./src/sharedTsgoLaunch.ts",
    "./src/runSummaryOracle.ts"
  ],
  "exclude": [
    "./e2e/fixtures",
    "./e2e/dx/vitest.config.ts",
    "./e2e/lib/vitest.config.mts",
    "./e2e/acceptance/vitest.config.ts",
    "./e2e/dx/**/*.unit.test.ts",
    "./e2e/lib/**/*.unit.test.ts",
    "./e2e/acceptance/**/*.unit.test.ts"
  ],
  "compilerOptions": {
    "outDir": "./out-test",
    "rootDir": ".",
    "target": "ES2020",
    // The extension package is CommonJS, so Node16 mode retains CommonJS emit
    // while using the supported Node resolution model in TypeScript 6.
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["mocha", "node"],
    "resolveJsonModule": true
  }
}
