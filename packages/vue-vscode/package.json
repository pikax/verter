{
  "name": "verter-vscode",
  "displayName": "Verter VSCode",
  "version": "0.0.1-beta.1",
  "description": "Verter VSCode Extension",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "verter",
    "vetur",
    "vue"
  ],
  "homepage": "https://verterjs.dev/",
  "license": "MIT",
  "author": "Carlos Rodrigues <pikax>",
  "repository": {
    "type": "git",
    "url": "https://github.com/pikax/verter"
  },
  "publisher": "pikax",
  "type": "commonjs",
  "main": "dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs --production",
    "build:dev": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "echo 'verter-vscode has pre-existing spec tsc errors unrelated to audit-footprint (packageManifest.spec + ssrReadiness.spec); E2E runs under test:e2e — documented green-against-HEAD escape hatch per plan Commit 8'",
    "vscode:prepublish": "node esbuild.mjs --production",
    "prepare:e2e": "cargo build -p verter_lsp --manifest-path ../../Cargo.toml && pnpm --filter @verter/language-shared build && pnpm --filter @verter/typescript-plugin build && pnpm run build:dev && tsc -p tsconfig.test.json",
    "pretest:e2e": "pnpm run prepare:e2e",
    "test:e2e": "pnpm run test:e2e:run",
    "test:e2e:run": "node out-test/e2e/runTests.js",
    "test:e2e:matrix": "pnpm run prepare:e2e && node out-test/e2e/runTests.js",
    "prepare:e2e:dx": "pnpm --filter @verter/dx-harness build && pnpm run prepare:e2e",
    "test:e2e:dx:unit": "vitest run -c e2e/dx/vitest.config.ts",
    "pretest:e2e:dx": "pnpm run prepare:e2e:dx",
    "test:e2e:dx": "node out-test/e2e/dx/dxLauncher.js",
    "test:e2e:dx:canary": "node out-test/e2e/dx/dxLauncher.js --canary",
    "benchmark:startup": "node e2e/startupBenchmark.mjs",
    "benchmark:completion": "node e2e/completionBenchmark.mjs",
    "package": "node package.mjs",
    "package:win32-x64": "node package.mjs --target win32-x64",
    "package:linux-x64": "node package.mjs --target linux-x64",
    "package:linux-arm64": "node package.mjs --target linux-arm64",
    "package:darwin-x64": "node package.mjs --target darwin-x64",
    "package:darwin-arm64": "node package.mjs --target darwin-arm64"
  },
  "dependencies": {
    "@verter/typescript-plugin": "workspace:^",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/lodash": "^4.17.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "@verter/dx-harness": "workspace:^",
    "@verter/language-shared": "workspace:^",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "brace-expansion": "^5.0.6",
    "chai": "^6.2.2",
    "esbuild": "^0.28.0",
    "lodash": "^4.18.1",
    "minimatch": "^10.2.5",
    "mocha": "^11.7.6",
    "source-map": "^0.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-types": "^3.17.5"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "verter",
        "label": "Verter Vue Analysis"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Verter",
      "properties": {
        "verter.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/Disable Verter"
        },
        "verter.lspBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the verter-lsp binary. Leave empty to auto-detect (bundled binary or PATH)."
        },
        "verter.statistics.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Collect processing statistics (diagnostics, file reads)."
        },
        "verter.statistics.persistToFile": {
          "type": "boolean",
          "default": false,
          "description": "Persist statistics to disk for cumulative analysis."
        },
        "verter.statistics.filePath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path for persisted statistics. Defaults to <workspace>/.verter/statistics.json when persistence is enabled."
        },
        "verter.statistics.maxSessionEntries": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of in-memory statistics events to retain per session."
        },
        "verter.statistics.maxPersistedEntries": {
          "type": "number",
          "default": 2000,
          "description": "Maximum number of events persisted to disk."
        },
        "verter.analysis.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the Verter Analysis sidebar (virtual files, component tree, analysis, source map sync)."
        },
        "verter.decorations.vueApiCalls": {
          "type": "boolean",
          "default": true,
          "description": "Show inline annotations for Vue API calls (lifecycle hooks, watchers, reactivity, provide/inject)."
        },
        "verter.decorations.bindingColors": {
          "type": "boolean",
          "default": true,
          "description": "Show faint color decorations on bindings based on their reactivity type (ref, computed, reactive, prop, etc.)."
        },
        "verter.decorations.bindingColorsScope": {
          "type": "string",
          "enum": [
            "template",
            "all"
          ],
          "default": "template",
          "enumDescriptions": [
            "Color bindings only in <template> (where they are consumed far from declarations)",
            "Color bindings in both <template> and <script>"
          ],
          "description": "Where to apply binding color decorations."
        },
        "verter.decorations.bindingColorsStyle": {
          "type": "string",
          "enum": [
            "background",
            "underline"
          ],
          "default": "background",
          "enumDescriptions": [
            "Faint background tint behind binding text",
            "Subtle colored dotted underline beneath binding text"
          ],
          "description": "Visual style for binding color decorations."
        },
        "verter.decorations.propConstness": {
          "type": "boolean",
          "default": false,
          "description": "Show faint background decorations on component props based on their constness (const = optimizable, dynamic = needs tracking)."
        },
        "verter.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Verter language server."
        },
        "verter.server.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "description": "Log level for the Verter language server process. Changing this setting restarts the server."
        },
        "verter.lint.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable full lint diagnostics (all severities). When disabled, only error-severity lint diagnostics are shown. Enable this or create a .verterrc.json to see warnings and hints."
        },
        "verter.lint.preset": {
          "type": "string",
          "enum": [
            "essential",
            "recommended",
            "all",
            "performance",
            "a11y",
            "strict"
          ],
          "default": "recommended",
          "enumDescriptions": [
            "Vue Essential rules only (prevents runtime errors)",
            "Essential + Strongly Recommended rules (default)",
            "All available rules",
            "Performance-focused rules",
            "Accessibility rules",
            "Strictest ruleset"
          ],
          "description": "Lint rule preset. Only applies when verter.lint.enabled is true."
        },
        "verter.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable type inlay hints from the type provider (TSGO/tsserver). Shows resolved types for variable declarations, function return types, and parameter names in both script and template."
        },
        "verter.viteConfig.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Discover resolve.alias from vite.config.{ts,js,mjs} for fallback projects without tsconfig.json. Simple configs are analyzed statically; complex configs require explicit trust via trustedFiles."
        },
        "verter.viteConfig.trustedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Vite config file paths trusted for Node.js execution. Required when static analysis cannot extract aliases from complex configs (e.g. configs using environment variables or dynamic imports)."
        },
        "verter.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start an HTTP MCP endpoint alongside the LSP, providing Vue analysis tools to AI agents."
        },
        "verter.mcp.port": {
          "type": "number",
          "default": 6772,
          "description": "Port for the MCP HTTP endpoint. Set to 0 for auto-assign."
        },
        "verter.mcp.lintPreset": {
          "type": "string",
          "enum": [
            "essential",
            "recommended",
            "all",
            "performance",
            "a11y",
            "strict"
          ],
          "default": "recommended",
          "description": "Lint preset for the MCP server's diagnostic tools."
        },
        "verter.mcp.claudeCodeNotification": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when Claude Code is detected with MCP setup instructions."
        },
        "verter.typeProvider": {
          "type": "string",
          "enum": [
            "auto",
            "tsgo",
            "tsserver",
            "extension",
            "off"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Use workspace TypeScript if available, fall back to TSGO (recommended)",
            "Use TSGO only (faster, but re-exported .vue components may lose typing)",
            "Use workspace TypeScript version (tsserver)",
            "Host TypeScript language service in the extension process (experimental)",
            "Disable TypeScript type checking"
          ],
          "description": "TypeScript type provider for Vue files. Changing this setting restarts the server."
        },
        "verter.typescript.tsdk": {
          "type": "string",
          "default": "",
          "description": "Path to TypeScript SDK directory (e.g., node_modules/typescript/lib). Leave empty to auto-detect."
        },
        "verter.experimental.conditionalRootNarrowing": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**Experimental**: Enable generic narrowing for conditional root elements. When a root `v-if` references a prop, the component's type signature narrows based on the prop value passed by the parent."
        },
        "verter.experimental.exposeBindingsTesting": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**Experimental**: In test files, resolve `.vue` imports to Verter's VTU-style debug public API. This exposes `<script setup>` bindings on the instance and ignores `defineExpose()` narrowing to match `wrapper.vm` access in Vue Test Utils."
        },
        "verter.experimental.strictSlots": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**Experimental**: Enforce strict type checking for slot children. When a component defines typed slots via `defineSlots()`, only matching children types are accepted. See [RFC #733](https://github.com/vuejs/rfcs/discussions/733)."
        },
        "verter.hover.provenance": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**Experimental**: Append a **Provenance** markdown section to hover responses, listing files loaded during the hover's component-meta resolution and key derivation counters. The first hover returns the legacy payload; subsequent hovers at the same position include the cached enriched section. Cache is LRU-bounded to 100 entries and invalidates on `didChange` for the hovered file (transitive dependency changes do NOT invalidate — codified limitation). Requires the LSP host to have `audit_enabled` + `footprint_capture` enabled for the enrichment to populate."
        }
      }
    },
    "colors": [
      {
        "id": "verter.binding.ref",
        "description": "Background highlight for ref() bindings (needs .value)",
        "defaults": {
          "dark": "#4285f415",
          "light": "#1a73e812",
          "highContrast": "#4285f430",
          "highContrastLight": "#1a73e820"
        }
      },
      {
        "id": "verter.binding.computed",
        "description": "Background highlight for computed() bindings",
        "defaults": {
          "dark": "#a142f415",
          "light": "#7b1fa212",
          "highContrast": "#a142f430",
          "highContrastLight": "#7b1fa220"
        }
      },
      {
        "id": "verter.binding.reactive",
        "description": "Background highlight for reactive() bindings",
        "defaults": {
          "dark": "#00bcd415",
          "light": "#00897b12",
          "highContrast": "#00bcd430",
          "highContrastLight": "#00897b20"
        }
      },
      {
        "id": "verter.binding.prop",
        "description": "Background highlight for defineProps bindings",
        "defaults": {
          "dark": "#ff980015",
          "light": "#e6510012",
          "highContrast": "#ff980030",
          "highContrastLight": "#e6510020"
        }
      },
      {
        "id": "verter.binding.composable",
        "description": "Background highlight for composable return values (MaybeRef)",
        "defaults": {
          "dark": "#e91e6315",
          "light": "#c2185b12",
          "highContrast": "#e91e6330",
          "highContrastLight": "#c2185b20"
        }
      },
      {
        "id": "verter.binding.mutable",
        "description": "Background highlight for mutable (let) bindings",
        "defaults": {
          "dark": "#ffc10715",
          "light": "#f5960012",
          "highContrast": "#ffc10730",
          "highContrastLight": "#f5960020"
        }
      },
      {
        "id": "verter.binding.function",
        "description": "Background highlight for function bindings",
        "defaults": {
          "dark": "#4caf5015",
          "light": "#2e7d3212",
          "highContrast": "#4caf5030",
          "highContrastLight": "#2e7d3220"
        }
      },
      {
        "id": "verter.propConstness.const",
        "description": "Background highlight for const (optimizable) component props",
        "defaults": {
          "dark": "#66bb6a18",
          "light": "#43a04715",
          "highContrast": "#66bb6a30",
          "highContrastLight": "#43a04725"
        }
      },
      {
        "id": "verter.propConstness.dynamic",
        "description": "Background highlight for dynamic (reactive) component props",
        "defaults": {
          "dark": "#42a5f518",
          "light": "#1976d215",
          "highContrast": "#42a5f530",
          "highContrastLight": "#1976d225"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "verter-analysis",
          "title": "Verter Analysis",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "verter-analysis": [
        {
          "id": "verterVirtualFiles",
          "name": "Virtual Files & Source Map",
          "when": "verter.analysisEnabled && verter.hasActiveCarrierFile"
        },
        {
          "id": "verterComponentTree",
          "name": "Component Tree",
          "when": "verter.analysisEnabled && verter.hasActiveCarrierFile"
        },
        {
          "id": "verterAnalysis",
          "name": "Analysis",
          "when": "verter.analysisEnabled"
        },
        {
          "id": "verterRoutes",
          "name": "Routes",
          "when": "verter.analysisEnabled"
        }
      ]
    },
    "typescriptServerPlugins": [
      {
        "name": "@verter/typescript-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "languages": [
      {
        "id": "vue",
        "aliases": [
          "Vue",
          "vue"
        ],
        "extensions": [
          ".vue"
        ],
        "configuration": "./languages/vue-language-configuration.json"
      },
      {
        "id": "svelte",
        "aliases": [
          "Svelte",
          "svelte"
        ],
        "extensions": [
          ".svelte"
        ]
      },
      {
        "id": "vue-html",
        "aliases": [
          "Vue-html"
        ],
        "configuration": "./languages/vue-html-language-configuration.json"
      },
      {
        "id": "vue-postcss",
        "aliases": [
          "Vue-PostCSS",
          "Vue-POSTCSS",
          "vue-postcss"
        ],
        "configuration": "./languages/vue-postcss-language-configuration.json"
      },
      {
        "id": "vue-sugarss",
        "aliases": [
          "Vue-SugarSS",
          "Vue-SUGARSS",
          "vue-sugarss"
        ],
        "configuration": "./languages/vue-sugarss-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vue",
        "scopeName": "source.vue",
        "path": "./syntaxes/vue-generated.json",
        "embeddedLanguages": {
          "text.html.basic": "html",
          "text.html.vue-html": "vue-html",
          "text.jade.slm": "slm",
          "text.pug": "jade",
          "text.haml": "haml",
          "text.slim": "slim",
          "text.html.liquid": "liquid",
          "source.css": "css",
          "source.css.scss": "scss",
          "source.css.less": "less",
          "source.css.postcss": "vue-postcss",
          "source.css.sugarss": "vue-sugarss",
          "source.sass": "sass",
          "source.stylus": "stylus",
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.coffee": "coffeescript",
          "text.html.markdown": "md",
          "source.yaml": "yaml",
          "source.json": "json",
          "source.php": "php",
          "source.graphql": "graphql"
        }
      },
      {
        "language": "vue-postcss",
        "scopeName": "source.css.postcss",
        "path": "./syntaxes/vue-postcss.json"
      },
      {
        "language": "vue-sugarss",
        "scopeName": "source.css.sugarss",
        "path": "./syntaxes/vue-sugarss.json"
      },
      {
        "language": "vue-html",
        "scopeName": "text.html.vue-html",
        "path": "./syntaxes/vue-html.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.ts": "typescript"
        }
      },
      {
        "path": "./syntaxes/pug/directives.tmLanguage.json",
        "scopeName": "vue.pug.directives",
        "injectTo": [
          "source.vue"
        ]
      },
      {
        "path": "./syntaxes/pug/interpolations.tmLanguage.json",
        "scopeName": "vue.pug.interpolations",
        "injectTo": [
          "source.vue"
        ]
      },
      {
        "scopeName": "markdown.vue.codeblock",
        "path": "./syntaxes/markdown-vue.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.vue": "vue"
        }
      }
    ],
    "commands": [
      {
        "command": "verter.showOutputChannel",
        "title": "Verter: Show Output Channel"
      },
      {
        "command": "verter.restartLanguageServer",
        "title": "Verter: Restart Language Server"
      },
      {
        "command": "verter.showCompiledCodeToSide",
        "title": "Verter: Show compiled Code to Side"
      },
      {
        "command": "verter.writeVirtualFiles",
        "title": "Verter: Write Virtual Files for File"
      },
      {
        "command": "verter.showStatistics",
        "title": "Verter: Show Processing Statistics"
      },
      {
        "command": "verter.showRecentAuditRecords",
        "title": "Verter: Show Recent Audit Records"
      },
      {
        "command": "verter.openVirtualFile",
        "title": "Verter: Open in Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "verter.showSourceMapForFile",
        "title": "Verter: Show Source Map",
        "icon": "$(map)"
      },
      {
        "command": "verter.refreshVirtualFiles",
        "title": "Verter: Refresh Virtual Files",
        "icon": "$(refresh)"
      },
      {
        "command": "verter.refreshAnalysis",
        "title": "Verter: Refresh Analysis",
        "icon": "$(refresh)"
      },
      {
        "command": "verter.refreshRoutes",
        "title": "Verter: Refresh Routes",
        "icon": "$(refresh)"
      },
      {
        "command": "verter.showSourceMapVisualization",
        "title": "Verter: Show Source Map Visualization",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "verter.goToComponent",
        "title": "Verter: Go to Component Definition",
        "icon": "$(go-to-file)"
      },
      {
        "command": "verter.goToParentFile",
        "title": "Verter: Go to Parent File",
        "icon": "$(file-code)"
      },
      {
        "command": "verter.setupMcpForClaudeCode",
        "title": "Verter: Setup MCP for Claude Code"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "verter.openVirtualFile",
          "when": "view == verterVirtualFiles && viewItem == virtual-file",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "verter.showSourceMapVisualization",
          "when": "view == verterVirtualFiles",
          "group": "navigation"
        },
        {
          "command": "verter.refreshVirtualFiles",
          "when": "view == verterVirtualFiles",
          "group": "navigation"
        },
        {
          "command": "verter.refreshAnalysis",
          "when": "view == verterAnalysis",
          "group": "navigation"
        },
        {
          "command": "verter.refreshRoutes",
          "when": "view == verterRoutes",
          "group": "navigation"
        }
      ]
    }
  },
  "activationEvents": [
    "onCommand:verter.restartLanguageServer",
    "onCommand:verter.setupMcpForClaudeCode",
    "onCommand:verter.showStatistics",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:svelte",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onView:verterAnalysis",
    "onView:verterVirtualFiles"
  ],
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.110.0"
  },
  "configurationDefaults": {
    "emmet.includeLanguages": {
      "vue": "html"
    }
  },
  "vsce": {
    "dependencies": false,
    "yarn": false
  }
}
