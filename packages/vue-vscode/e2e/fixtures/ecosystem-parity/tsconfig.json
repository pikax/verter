{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "$lib/*": ["src/lib/*"],
      "#imports": ["src/nuxt-style/imports.ts"]
    },
    "types": ["vue/jsx"]
  },
  "include": ["src"]
}
