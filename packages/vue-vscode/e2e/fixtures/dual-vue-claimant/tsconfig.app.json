{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "composite": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "types": ["my-ambient-types"],
    "typeRoots": ["./types"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
