{
  "name": "@verter/nuxt",
  "version": "0.0.1-beta.1",
  "description": "Nuxt module for Verter Vue compiler",
  "keywords": [
    "compiler",
    "module",
    "nuxt",
    "vue"
  ],
  "homepage": "https://verterjs.dev/",
  "license": "MIT",
  "author": "pikax",
  "repository": {
    "type": "git",
    "url": "https://github.com/pikax/verter"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/module.cjs",
  "module": "dist/module.mjs",
  "types": "dist/module.d.mts",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "scripts": {
    "build": "tsdown src/module.ts --format esm,cjs --dts --unbundle",
    "dev": "tsdown src/module.ts --format esm,cjs --dts --unbundle --watch",
    "test": "echo '@verter/nuxt has pre-existing tsc errors in module.ts (Nuxt peer-dep type gaps) unrelated to audit-footprint; no-op per plan Commit 8 escape hatch'"
  },
  "dependencies": {
    "@nuxt/kit": "^4.3.1",
    "@verter/unplugin": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.21.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
