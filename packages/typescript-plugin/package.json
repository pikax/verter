{
  "name": "@verter/typescript-plugin",
  "version": "0.0.1-beta.7",
  "description": "Vue TypeScript Plugin powered by Verter",
  "keywords": [
    "language-service",
    "plugin",
    "typescript",
    "vue"
  ],
  "homepage": "https://verterjs.dev/",
  "license": "MIT",
  "author": "Carlos Rodrigues <pikax>",
  "repository": {
    "type": "git",
    "url": "https://github.com/pikax/verter"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./verter-types-stub": {
      "types": "./dist/helpers/verterTypesStub.d.ts",
      "require": "./dist/helpers/verterTypesStub.js",
      "import": "./dist/helpers/verterTypesStub.js",
      "default": "./dist/helpers/verterTypesStub.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@verter/language-shared": "workspace:*",
    "@verter/native": "workspace:^",
    "@verter/svelte-jsx": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
