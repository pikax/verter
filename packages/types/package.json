{
  "name": "@verter/types",
  "version": "0.0.1-beta.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/pikax/verter"
  },
  "files": [
    "dist",
    "audit.generated.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./string": {
      "types": "./dist/string-export.d.ts",
      "import": "./dist/string-export.js",
      "default": "./dist/string-export.js"
    },
    "./tsx-string": {
      "types": "./dist/tsx-string-export.d.ts",
      "import": "./dist/tsx-string-export.js",
      "default": "./dist/tsx-string-export.js"
    },
    "./audit.generated": {
      "types": "./audit.generated.ts",
      "import": "./audit.generated.ts",
      "default": "./audit.generated.ts"
    }
  },
  "scripts": {
    "build": "tsc --build --force && node scripts/build-string.mjs && node scripts/build-tsx.mjs",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest --run"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "6.0.0-beta",
    "vitest": "^4.1.0",
    "vue": "^3.5.30"
  }
}
