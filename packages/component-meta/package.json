{
  "name": "@verter/component-meta",
  "version": "0.0.1-beta.1",
  "description": "Extract Vue component metadata (props, events, slots, models, expose) with a generic Type IR",
  "keywords": [
    "component",
    "histoire",
    "json-schema",
    "metadata",
    "props",
    "storybook",
    "vue",
    "zod"
  ],
  "homepage": "https://verterjs.dev/",
  "license": "MIT",
  "author": "pikax",
  "repository": {
    "type": "git",
    "url": "https://github.com/pikax/verter"
  },
  "files": [
    "dist",
    "readme.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./storybook": {
      "types": "./dist/adapters/storybook.d.ts",
      "import": "./dist/adapters/storybook.js",
      "default": "./dist/adapters/storybook.js"
    },
    "./histoire": {
      "types": "./dist/adapters/histoire.d.ts",
      "import": "./dist/adapters/histoire.js",
      "default": "./dist/adapters/histoire.js"
    },
    "./zod": {
      "types": "./dist/adapters/zod.d.ts",
      "import": "./dist/adapters/zod.js",
      "default": "./dist/adapters/zod.js"
    },
    "./json-schema": {
      "types": "./dist/adapters/json-schema.d.ts",
      "import": "./dist/adapters/json-schema.js",
      "default": "./dist/adapters/json-schema.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "import": "./dist/compat/index.js",
      "default": "./dist/compat/index.js"
    },
    "./published-surface": {
      "types": "./dist/published-surface.d.ts",
      "import": "./dist/published-surface.js",
      "default": "./dist/published-surface.js"
    }
  },
  "scripts": {
    "build": "npx shx rm -rf dist tsconfig.tsbuildinfo && tsc -b --force",
    "dev": "tsc -b --watch",
    "clean": "npx shx rm -rf .turbo dist tsconfig.tsbuildinfo",
    "test": "vitest --run --exclude '**/native-eval.spec.ts' --exclude '**/checker.benchmark.spec.ts' --exclude '**/checker.spec.ts'",
    "test:native": "vitest --run native-eval"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@verter/language-shared": "workspace:*",
    "@verter/native": "workspace:*",
    "@verter/proto": "workspace:*",
    "@verter/type-ir": "workspace:*",
    "@verter/types": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@verter/wasm": "workspace:*",
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@verter/wasm": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
