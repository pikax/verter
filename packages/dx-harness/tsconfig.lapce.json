{
  "extends": "../../tsconfig.base.json",
  "include": ["./lapce"],
  "exclude": ["dist", "node_modules", "test"],
  "compilerOptions": {
    "outDir": "./dist/lapce",
    "rootDir": "./lapce",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "tsBuildInfoFile": "./tsconfig.lapce.tsbuildinfo",
    "paths": {
      "@verter/dx-harness/jetbrains": ["./dist/jetbrains/index.d.ts"]
    }
  },
  "references": [{ "path": "./tsconfig.jetbrains.json" }]
}
