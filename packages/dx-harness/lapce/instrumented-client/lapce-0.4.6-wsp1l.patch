+//! WSP1L instrumentation for Lapce (reference instrumented-client build).
+//!
+//! This module is the instrumentation half of the Verter WSP1L "instrumented
+//! client build" automation path (charter WSP1L.1): it adds (a) an external
+//! drive channel that performs the scripted `open`/`type`/`complete`/
+//! `navigate`/`close` interactions on the real UI event loop, and (b) UI
+//! stage stamps — `verter ui-stamp {json}` lines on stderr — observed at the
+//! real pipeline seams of each interaction:
+//!
+//! - `input_dispatched` — the drive command was accepted on the UI thread and
+//!   the interaction's actuation began.
+//! - `decoded` — the interaction's payload was decoded into an editor
+//!   mutation: `Doc::do_insert`'s buffer deltas for `type`, the completion
+//!   response items for `complete`, the definition response for `navigate`,
+//!   the loaded file content for `open`.
+//! - `applied` — the mutation was applied to editor state (cursor/buffer for
+//!   `type`, filtered completion data for `complete`, the dispatched jump for
+//!   `navigate`, the reloaded buffer for `open`).
+//! - `painted` — the first `EditorView` paint after `applied` (Lapce's
+//!   invalidation and cursor-blink frames drive `EditorView` repaints, so an
+//!   applied interaction is presented in a real observed frame).
+//!
+//! The channel is INACTIVE unless `VERTER_WSP1L_DRIVE_ADDR` is set at
+//! startup: stock runs are untouched, and stamps are emitted only for steps
+//! the external driver explicitly began. Nothing here guesses a timestamp —
+//! a stage that was not observed is simply not stamped, and the driver treats
+//! the hole as a hole.
+
+use std::io::{BufRead, BufReader, Write};
+use std::net::TcpStream;
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::sync::mpsc::Sender;
+use std::time::Duration;
+
+use floem::reactive::{SignalGet, SignalWith};
+use serde_json::{Value, json};
+
+use crate::app::AppData;
+use crate::editor::EditorData;
+use lapce_rpc::file::PathObject;
+
+const UI_STAGE_ORDER: [&str; 4] = ["input_dispatched", "decoded", "applied", "painted"];
+
+/// How long the drive thread waits for a step's `painted` ack before
+/// reporting a hole to the driver (the driver bounds its own wait too).
+const STEP_ACK_TIMEOUT: Duration = Duration::from_secs(120);
+
+struct ActiveStep {
+    kind: String,
+    request_epoch: u64,
+    source_epoch: Option<u64>,
+    next_stage: usize,
+    stamps: Vec<Value>,
+    ack: Option<Sender<Value>>,
+}
+
+static ACTIVE_STEP: Mutex<Option<ActiveStep>> = Mutex::new(None);
+
+pub fn unix_now_ms() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0)
+}
+
+fn emit_stage_locked(step: &mut ActiveStep, stage: &str) {
+    let Some(index) = UI_STAGE_ORDER.iter().position(|s| *s == stage) else {
+        return;
+    };
+    if index < step.next_stage {
+        // Already emitted, or a pipeline event that does not belong to this
+        // step's progression. Never guess.
+        return;
+    }
+    // A skipped-over stage stays an honest hole (unobserved, never zero).
+    step.next_stage = index + 1;
+    let at_unix_ms = unix_now_ms();
+    let payload = json!({
+        "kind": step.kind,
+        "requestEpoch": step.request_epoch,
+        "sourceEpoch": step.source_epoch,
+        "stage": stage,
+        "atUnixMs": at_unix_ms,
+    });
+    eprintln!("verter ui-stamp {payload}");
+    step.stamps.push(payload);
+}
+
+/// Record one UI stage observation for the step the external driver began.
+/// No-ops when no step is active (stock runs and interleaved background
+/// work never stamp).
+pub fn emit_stage(stage: &str) {
+    let mut guard = ACTIVE_STEP.lock().unwrap();
+    if let Some(step) = guard.as_mut() {
+        emit_stage_locked(step, stage);
+    }
+}
+
+/// The first `EditorView` paint after `applied` completes the step: stamps
+/// `painted` and hands the collected observations to the drive thread.
+pub fn on_editor_paint() {
+    let mut guard = ACTIVE_STEP.lock().unwrap();
+    if !guard
+        .as_ref()
+        .is_some_and(|step| UI_STAGE_ORDER[step.next_stage] == "painted")
+    {
+        return;
+    }
+    if let Some(step) = guard.as_mut() {
+        emit_stage_locked(step, "painted");
+    }
+    if let Some(finished) = guard.take() {
+        if let Some(ack) = finished.ack {
+            let _ = ack.send(json!({
+                "kind": finished.kind,
+                "requestEpoch": finished.request_epoch,
+                "sourceEpoch": finished.source_epoch,
+                "stamps": finished.stamps,
+            }));
+        }
+    }
+}
+
+/// One scripted interaction received over the drive channel.
+#[derive(Debug, Clone)]
+pub struct StepSpec {
+    pub kind: String,
+    pub request_epoch: u64,
+    pub source_epoch: Option<u64>,
+    pub text: Option<String>,
+    pub path: Option<String>,
+    /// 1-based open position (Lapce `path:line:column` semantics).
+    pub line: Option<usize>,
+    pub column: Option<usize>,
+}
+
+fn parse_step(line: &str) -> Option<StepSpec> {
+    let value: Value = serde_json::from_str(line.trim()).ok()?;
+    let kind = value.get("kind")?.as_str()?.to_string();
+    if !["open", "type", "complete", "navigate", "close"].contains(&kind.as_str()) {
+        return None;
+    }
+    let request_epoch = value.get("requestEpoch")?.as_u64()?;
+    let source_epoch = value
+        .get("sourceEpoch")
+        .and_then(|v| v.as_u64());
+    let text = value.get("text").and_then(|v| v.as_str()).map(String::from);
+    if kind == "type" && text.as_deref().map(str::chars).map(Iterator::count) != Some(1) {
+        // One keystroke per step: the stage stamps measure a single real
+        // dispatch→decode→apply→paint pipeline, not a batch.
+        return None;
+    }
+    if kind == "open" && value.get("path").and_then(|v| v.as_str()).is_none() {
+        return None;
+    }
+    Some(StepSpec {
+        kind,
+        request_epoch,
+        source_epoch,
+        text,
+        path: value.get("path").and_then(|v| v.as_str()).map(String::from),
+        line: value.get("line").and_then(|v| v.as_u64()).map(|l| l as usize),
+        column: value
+            .get("column")
+            .and_then(|v| v.as_u64())
+            .map(|c| c as usize),
+    })
+}
+
+/// Drive-channel thread body: connect to the external driver, announce
+/// readiness, then serve one command line at a time. Each step's ack carries
+/// exactly the stamps the UI loop observed; a hole is reported as an error
+/// ack, never filled in.
+pub fn run_drive_channel(ui_dispatch: Sender<(StepSpec, Sender<Value>)>) {
+    let Ok(addr) = std::env::var("VERTER_WSP1L_DRIVE_ADDR") else {
+        return; // instrumentation inactive in stock runs
+    };
+    let mut stream = match TcpStream::connect(&addr) {
+        Ok(stream) => stream,
+        Err(err) => {
+            eprintln!("verter drive: could not connect to {addr}: {err}");
+            return;
+        }
+    };
+    let ready = json!({
+        "event": "ready",
+        "lapceVersion": lapce_core::meta::VERSION,
+    });
+    if let Err(err) = writeln!(stream, "{ready}") {
+        eprintln!("verter drive: could not send ready: {err}");
+        return;
+    }
+    let _ = stream.flush();
+    let reader = BufReader::new(match stream.try_clone() {
+        Ok(reader) => reader,
+        Err(err) => {
+            eprintln!("verter drive: could not clone stream: {err}");
+            return;
+        }
+    });
+    for line in reader.lines() {
+        let Ok(line) = line else { break };
+        let Some(spec) = parse_step(&line) else {
+            let _ = writeln!(stream, r#"{{"error":"unparsable-step"}}"#);
+            let _ = stream.flush();
+            continue;
+        };
+        let (ack_tx, ack_rx) = std::sync::mpsc::channel();
+        if ui_dispatch.send((spec, ack_tx)).is_err() {
+            break;
+        }
+        let reply = match ack_rx.recv_timeout(STEP_ACK_TIMEOUT) {
+            Ok(ack) => ack.to_string(),
+            Err(_) => r#"{"error":"step-paint-not-observed"}"#.to_string(),
+        };
+        if writeln!(stream, "{reply}").is_err() {
+            break;
+        }
+        let _ = stream.flush();
+    }
+}
+
+/// Begin a step on the UI thread (stamps `input_dispatched`) and actuate it
+/// against the real editor. Called from the app's reactive dispatch, i.e. on
+/// the UI event loop.
+pub fn dispatch_step(app_data: &AppData, spec: &StepSpec, ack: Sender<Value>) {
+    {
+        let mut guard = ACTIVE_STEP.lock().unwrap();
+        *guard = Some(ActiveStep {
+            kind: spec.kind.clone(),
+            request_epoch: spec.request_epoch,
+            source_epoch: spec.source_epoch,
+            next_stage: 0,
+            stamps: Vec::new(),
+            ack: Some(ack),
+        });
+    }
+    emit_stage("input_dispatched");
+    match spec.kind.as_str() {
+        "open" => {
+            if let Some(window_tab) = app_data.active_window_tab() {
+                if let Some(path) = &spec.path {
+                    let path_object = match (spec.line, spec.column) {
+                        (Some(line), Some(column)) => {
+                            PathObject::new(PathBuf::from(path), false, line, column)
+                        }
+                        _ => PathObject::from_path(PathBuf::from(path), false),
+                    };
+                    window_tab.open_paths(&[path_object]);
+                    return;
+                }
+            }
+            eprintln!(
+                "verter drive: open step '{}' found no window tab to act on",
+                spec.request_epoch
+            );
+        }
+        "type" => {
+            if let Some(editor) = active_editor(app_data) {
+                editor.wsp1l_drive_type(spec.text.as_deref().unwrap_or_default());
+                return;
+            }
+            eprintln!(
+                "verter drive: type step '{}' found no active editor",
+                spec.request_epoch
+            );
+        }
+        "complete" => {
+            if let Some(editor) = active_editor(app_data) {
+                editor.wsp1l_drive_complete();
+                return;
+            }
+            eprintln!(
+                "verter drive: complete step '{}' found no active editor",
+                spec.request_epoch
+            );
+        }
+        "navigate" => {
+            if let Some(editor) = active_editor(app_data) {
+                editor.wsp1l_drive_goto();
+                return;
+            }
+            eprintln!(
+                "verter drive: navigate step '{}' found no active editor",
+                spec.request_epoch
+            );
+        }
+        "close" => {
+            if let Some(window_tab) = app_data.active_window_tab() {
+                let main_split = &window_tab.main_split;
+                if let Some(editor_tab_id) =
+                    main_split.active_editor_tab.get_untracked()
+                {
+                    if let Some(editor_tab) = main_split
+                        .editor_tabs
+                        .with_untracked(|tabs| tabs.get(&editor_tab_id).copied())
+                    {
+                        if let Some((_, _, child)) = editor_tab.with_untracked(|tab| {
+                            tab.children.get(tab.active).cloned()
+                        }) {
+                            main_split.editor_tab_child_close(editor_tab_id, child, true);
+                            return;
+                        }
+                    }
+                }
+            }
+            eprintln!(
+                "verter drive: close step '{}' found no active editor tab",
+                spec.request_epoch
+            );
+        }
+        _ => {}
+    }
+}
+
+fn active_editor(app_data: &AppData) -> Option<EditorData> {
+    app_data
+        .active_window_tab()?
+        .main_split
+        .active_editor
+        .get_untracked()
+}
