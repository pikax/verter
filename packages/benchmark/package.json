{
  "name": "@verter/benchmark",
  "version": "0.0.1",
  "private": true,
  "description": "Performance benchmarks comparing Vue and Verter compilation",
  "license": "MIT",
  "author": "pikax",
  "type": "module",
  "scripts": {
    "bench": "node --import tsx src/index.ts",
    "bench:json": "node --import tsx src/index.ts --json",
    "bench:ffi": "node --import tsx src/ffi-bench.ts",
    "bench:edit-ops": "node --import tsx src/edit-ops-bench.ts",
    "bench:apple": "node --import tsx src/apple-to-apple.ts",
    "bench:type-check": "node --import tsx src/type-check-bench.ts",
    "bench:lsp": "node --import tsx src/lsp-bench.ts",
    "bench:lsp:json": "node --import tsx src/lsp-bench.ts --json",
    "bench:meta": "node --import tsx src/meta-bench.ts",
    "bench:meta:json": "node --import tsx src/meta-bench.ts --json",
    "bench:meta:ui": "node --expose-gc --import tsx src/meta-ui-bench.ts",
    "bench:meta:ui:json": "node --expose-gc --import tsx src/meta-ui-bench.ts --json",
    "bench:meta:ui:stress": "node --expose-gc --import tsx src/meta-ui-stress.ts",
    "bench:meta:ui:report": "node --import tsx src/meta-ui-report.ts",
    "bench:meta:ui:setup": "node ../../scripts/benchmark/setup-meta-ui.mjs",
    "test": "vitest run src/audit-validator.spec.ts src/corpus-trace-runner.spec.ts src/workspace-invariants.spec.ts src/audit-harness-bootstrap.spec.ts"
  },
  "dependencies": {
    "@verter/component-meta": "workspace:*",
    "@verter/native": "workspace:*",
    "@verter/wasm": "workspace:*",
    "@vue/compiler-sfc": "^3.5.34",
    "@vue/language-server": "^3.3.2",
    "magic-string": "^0.30.21",
    "tinybench": "^6.0.2",
    "vue": "^3.5.34",
    "vue-component-meta": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@verter/types": "workspace:^",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
