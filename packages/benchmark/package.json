    "bench:edit-ops": "node --import tsx src/edit-ops-bench.ts"
  },
  "dependencies": {
    "@verter/native": "workspace:*",
    "@verter/wasm": "workspace:*",
    "@vue/compiler-sfc": "^3.5.27",
    "magic-string": "^0.30.21",
    "tinybench": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
