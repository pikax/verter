{
  "component": "Alert",
  "componentPath": "src/runtime/components/Alert.vue",
  "maxTotalDurationMs": 2000,
  "required": [
    {
      "namePattern": "resolve_component_meta",
      "detailPattern": "mode=Expanded",
      "note": "must resolve component meta in Expanded mode"
    },
    {
      "namePattern": "resolve_component_meta_result",
      "detailPattern": "has_evaluated_types=true",
      "note": "must produce evaluated types"
    },
    {
      "namePattern": "compute_evaluated_types_expand_macros",
      "detailPattern": "store_view=true",
      "note": "macro expansion must run with a valid store view"
    }
  ],
  "forbidden": [
    {
      "namePattern": "seed_imported_dependency_base_in_view",
      "note": "legacy imported-dependency seeding path must not execute"
    },
    {
      "namePattern": "legacy_resolved_type_cache",
      "note": "legacy resolved type cache must not be populated"
    },
    {
      "namePattern": "/store_view=false/",
      "detailPattern": "types/index.ts",
      "note": "types/index.ts barrel must not be accessed without a store view"
    }
  ],
  "maxCounts": [
    {
      "namePattern": "resolve_imported_type_root",
      "maxCount": 40,
      "note": "Alert resolves ~11 imported type roots (start+end events + nested); baseline is 33"
    },
    {
      "namePattern": "current_eval_state",
      "maxCount": 50,
      "note": "current_eval_state calls should be bounded; baseline is 34"
    }
  ],
  "maxDurations": [
    {
      "namePattern": "resolve_component_meta",
      "maxDurationMs": 2000,
      "note": "total resolution should complete within 2s"
    },
    {
      "namePattern": "resolve_imported_type_root",
      "maxDurationMs": 500,
      "note": "any single imported type root resolution should take under 500ms"
    }
  ]
}
