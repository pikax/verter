{
  "name": "@verter/wasm",
  "version": "0.0.1-alpha.3",
  "description": "WASM bindings for Verter Vue compiler",
  "keywords": ["vue", "compiler", "wasm", "webassembly"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pikax/verter"
  },
  "author": "pikax",
  "homepage": "https://verterjs.dev/",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "wasm"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/verter_wasm --target web --out-dir ../../packages/wasm/wasm",
    "build:ts": "tsdown",
    "build:copy-playground": "npx shx cp wasm/verter_wasm_bg.wasm ../playground/public/verter_wasm_bg.wasm",
    "build": "pnpm run build:wasm && pnpm run build:ts && pnpm run build:copy-playground",
    "test": "vitest run"
  },
  "devDependencies": {
    "@verter/native": "workspace:^",
    "tsdown": "^0.21.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
