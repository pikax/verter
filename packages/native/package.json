{
  "name": "@verter/native",
  "version": "0.0.1-beta.1",
  "description": "Native Node.js bindings for Verter Vue compiler",
  "keywords": [
    "bindings",
    "compiler",
    "napi",
    "native",
    "vue"
  ],
  "homepage": "https://verterjs.dev/",
  "license": "MIT",
  "author": "pikax",
  "repository": {
    "type": "git",
    "url": "https://github.com/pikax/verter"
  },
  "files": [
    "index.js",
    "host-types.ts",
    "dist"
  ],
  "main": "index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./index.js"
    },
    "./host-types": {
      "types": "./host-types.ts"
    }
  },
  "scripts": {
    "clean:dist": "node ./scripts/clean-dist.mjs",
    "build:types": "pnpm exec tsc --declaration --emitDeclarationOnly --outDir dist index.ts",
    "build": "pnpm run clean:dist && napi build -o dist --platform --release --manifest-path ../../crates/verter_napi/Cargo.toml && pnpm run build:types",
    "build:debug": "pnpm run clean:dist && napi build -o dist --platform --manifest-path ../../crates/verter_napi/Cargo.toml && pnpm run build:types",
    "prepublishOnly": "pnpm run build && napi prepublish -t npm",
    "artifacts": "napi artifacts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1",
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "optionalDependencies": {
    "@verter/native-darwin-arm64": "workspace:*",
    "@verter/native-darwin-x64": "workspace:*",
    "@verter/native-linux-arm64-gnu": "workspace:*",
    "@verter/native-linux-arm64-musl": "workspace:*",
    "@verter/native-linux-x64-gnu": "workspace:*",
    "@verter/native-linux-x64-musl": "workspace:*",
    "@verter/native-win32-x64-msvc": "workspace:*"
  },
  "napi": {
    "binaryName": "verter-native",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
