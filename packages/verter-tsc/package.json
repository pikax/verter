{
  "name": "verter-tsc",
  "version": "0.0.1-alpha.3",
  "description": "Vue SFC type checker — verter-native vue-tsc replacement",
  "license": "MIT",
  "author": "pikax",
  "homepage": "https://verterjs.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/pikax/verter"
  },
  "keywords": ["vue", "typescript", "type-check", "vue-tsc", "verter"],
  "bin": {
    "verter-tsc": "./bin/run.js"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "build": "echo 'no build step — binary is distributed via optionalDependencies'"
  },
  "optionalDependencies": {
    "@verter/tsc-darwin-arm64": "workspace:*",
    "@verter/tsc-darwin-x64": "workspace:*",
    "@verter/tsc-linux-x64-gnu": "workspace:*",
    "@verter/tsc-win32-x64-msvc": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
