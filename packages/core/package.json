  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b --force",
    "dev": "tsc -b --watch",
    "generate": "node ./scripts/generate.js",
    "generate:fixtures": "npx tsx scripts/fixtures.generator.ts",
    "generate:fixtures:annotations": "npx tsx scripts/fixtures.generator.ts --annotations",
    "process": "node ./scripts/processDir.js",
    "lint": "TIMING=1 eslint src/**/*.ts* --fix",
    "test-generated": "tsc --noEmit --project tsconfig.generated.json",
    "test:generate": "pnpm run generate && pnpm run test-generated",
    "clean": "npx shx rm -rf .turbo dist tsconfig.tsbuildinfo",
    "test": "vitest"
  },
  "dependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@babel/parser": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@oxc-project/types": "^0.112.0",
    "@types/ts-expose-internals": "npm:ts-expose-internals@5.2.2",
    "@verter/types": "workspace:*",
    "@vue/compiler-core": "^3.5.27",
    "@vue/compiler-sfc": "^3.5.27",
    "@vue/shared": "^3.5.27",
    "acorn": "^8.15.0",
    "acorn-loose": "^8.5.2",
    "acorn-typescript": "^1.4.13",
    "deepmerge": "^4.3.1",
    "estree-walker": "^3.0.3",
    "glob": "^13.0.1",
    "oxc-parser": "^0.112.0",
    "source-map-js": "^1.2.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "@vitest/coverage-v8": "4.0.18",
    "@vue/compiler-dom": "^3.5.27",
    "@vue/runtime-core": "^3.5.27",
    "@vue/runtime-dom": "^3.5.27",
    "fs-extra": "^11.3.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18",
    "vue": "^3.5.27"
  },
  "typeX": "module"
}
