{
  "name": "@verter/core",
  "version": "0.0.1-beta.1",
  "description": "Vue SFC parser and TSX transformer",
  "keywords": ["vue", "compiler", "sfc", "typescript", "tsx"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pikax/verter"
  },
  "author": "pikax",
  "homepage": "https://verterjs.dev/",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b --force",
    "dev": "tsc -b --watch",
    "generate": "node ./scripts/generate.js",
    "generate:fixtures": "npx tsx scripts/fixtures.generator.ts",
    "generate:fixtures:annotations": "npx tsx scripts/fixtures.generator.ts --annotations",
    "process": "node ./scripts/processDir.js",
    "lint": "TIMING=1 eslint src/**/*.ts* --fix",
    "test-generated": "tsc --noEmit --project tsconfig.generated.json",
    "test:generate": "pnpm run generate && pnpm run test-generated",
    "clean": "npx shx rm -rf .turbo dist tsconfig.tsbuildinfo",
    "test": "vitest"
  },
  "dependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@babel/parser": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@oxc-project/types": "^0.117.0",
    "@types/ts-expose-internals": "npm:ts-expose-internals@5.6.3",
    "@verter/types": "workspace:*",
    "@vue/compiler-core": "^3.5.30",
    "@vue/compiler-sfc": "^3.5.30",
    "@vue/shared": "^3.5.30",
    "acorn": "^8.16.0",
    "acorn-loose": "^8.5.2",
    "acorn-typescript": "^1.4.13",
    "deepmerge": "^4.3.1",
    "estree-walker": "^3.0.3",
    "glob": "^13.0.6",
    "oxc-parser": "^0.117.0",
    "source-map-js": "^1.2.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "4.1.0",
    "@vue/compiler-dom": "^3.5.30",
    "@vue/runtime-core": "^3.5.30",
    "@vue/runtime-dom": "^3.5.30",
    "fs-extra": "^11.3.4",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0",
    "vue": "^3.5.30"
  },
  "typeX": "module"
}
