{
  "name": "@verter/typeinfo",
  "version": "0.0.1-beta.1",
  "description": "Typeinfo session — wraps the Rust host typeinfo substrate (list symbols, resolve named symbol, evaluate type expression) for downstream consumers",
  "keywords": [
    "type-resolution",
    "typeinfo",
    "verter",
    "vue"
  ],
  "homepage": "https://verterjs.dev/",
  "license": "MIT",
  "author": "pikax",
  "repository": {
    "type": "git",
    "url": "https://github.com/pikax/verter"
  },
  "files": [
    "dist",
    "readme.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npx shx rm -rf dist tsconfig.tsbuildinfo && tsc -b --force",
    "dev": "tsc -b --watch",
    "clean": "npx shx rm -rf .turbo dist tsconfig.tsbuildinfo",
    "test": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@verter/native": "workspace:^",
    "@verter/proto": "workspace:^",
    "@verter/type-ir": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "glob": "^13.0.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
