{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verter.architecture-closure.report.v1",
  "title": "Architecture-closure report",
  "description": "Shape of a candidate closure report. This schema rejects structurally malformed reports only: a row's semantic cells stay optional here so the validator can reject an omission for its own reason code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "target",
    "candidate",
    "owners",
    "trainReviews",
    "capabilities",
    "metrics",
    "evidence",
    "inventories",
    "exceptions"
  ],
  "properties": {
    "mode": { "enum": ["owner-lock", "closure"] },
    "target": { "$ref": "#/$defs/text" },
    "candidate": { "$ref": "#/$defs/text" },
    "owners": { "type": "array", "items": { "$ref": "#/$defs/owner" } },
    "trainReviews": { "type": "array", "items": { "$ref": "#/$defs/trainReview" } },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "inventories": { "$ref": "#/$defs/inventories" },
    "exceptions": { "type": "array", "items": { "$ref": "#/$defs/exception" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "textList": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "count": { "type": "integer", "minimum": 0 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug"],
      "properties": {
        "slug": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/text" },
        "classification": { "enum": ["required", "optional", "historical"] },
        "outcome": { "$ref": "#/$defs/text" },
        "outcomeIds": { "$ref": "#/$defs/textList" },
        "soleFinalOwner": { "$ref": "#/$defs/text" },
        "consumers": { "$ref": "#/$defs/textList" },
        "displacedRoutes": { "type": "array", "items": { "$ref": "#/$defs/displacedRoute" } },
        "evidenceRefs": { "$ref": "#/$defs/textList" },
        "dependencyPath": { "$ref": "#/$defs/textList" }
      }
    },
    "displacedRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "disposition"],
      "properties": {
        "route": { "$ref": "#/$defs/text" },
        "disposition": { "enum": ["deleted", "retargeted", "surviving"] },
        "survivingOwner": { "$ref": "#/$defs/text" }
      }
    },
    "trainReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train"],
      "properties": {
        "train": { "$ref": "#/$defs/text" },
        "candidate": { "$ref": "#/$defs/text" },
        "independent": { "type": "boolean" },
        "terminal": { "type": "boolean" },
        "checkpoints": { "$ref": "#/$defs/textList" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/reviewFinding" } }
      }
    },
    "reviewFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "severity": { "enum": ["P0", "P1", "P2", "P3"] },
        "status": { "enum": ["resolved", "rejected", "open", "deferred"] }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface"],
      "properties": {
        "surface": { "$ref": "#/$defs/text" },
        "stabilityClass": { "enum": ["stable", "preview", "experimental-unranked"] },
        "typedResult": { "$ref": "#/$defs/capabilityResult" },
        "limitation": { "$ref": "#/$defs/text" },
        "consumer": { "$ref": "#/$defs/text" },
        "executedVerification": { "$ref": "#/$defs/text" },
        "cases": { "type": "array", "items": { "$ref": "#/$defs/capabilityCase" } }
      }
    },
    "capabilityResult": { "enum": ["complete", "partial", "unsupported"] },
    "capabilityCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case"],
      "properties": {
        "case": { "$ref": "#/$defs/text" },
        "typedResult": { "$ref": "#/$defs/capabilityResult" },
        "limitation": { "$ref": "#/$defs/text" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row"],
      "properties": {
        "row": { "$ref": "#/$defs/text" },
        "evidenceRun": { "$ref": "#/$defs/text" },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "tags"],
          "properties": {
            "id": { "$ref": "#/$defs/text" },
            "tags": { "$ref": "#/$defs/textList" }
          }
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/metricResult" }
        },
        "result": { "$ref": "#/$defs/metricResult" },
        "unavailableReason": { "$ref": "#/$defs/text" }
      }
    },
    "metricResult": { "enum": ["pass", "fail", "unavailable"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "lane": { "$ref": "#/$defs/text" },
        "command": { "$ref": "#/$defs/text" },
        "evidenceRun": { "$ref": "#/$defs/text" },
        "candidate": { "$ref": "#/$defs/text" },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "matched"],
            "properties": {
              "name": { "$ref": "#/$defs/text" },
              "matched": { "type": "boolean" }
            }
          }
        },
        "terminalSummary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "complete": { "type": "boolean" },
            "selected": { "$ref": "#/$defs/count" },
            "executed": { "$ref": "#/$defs/count" },
            "expectedSkips": { "$ref": "#/$defs/count" },
            "unexpectedSkips": { "$ref": "#/$defs/count" },
            "passed": { "type": "boolean" }
          }
        },
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner"],
          "properties": {
            "kind": { "enum": ["local-execution", "ci"] },
            "owner": { "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "inventories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "observe"],
      "properties": {
        "engine": { "$ref": "#/$defs/engineInventory" },
        "observe": { "$ref": "#/$defs/observeInventory" },
        "reuse": { "$ref": "#/$defs/reuseInventory" }
      }
    },
    "engineInventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relocations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "$ref": "#/$defs/text" },
              "to": { "$ref": "#/$defs/text" }
            }
          }
        },
        "testMapping": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "discoveredBefore": { "$ref": "#/$defs/count" },
            "discoveredAfter": { "$ref": "#/$defs/count" },
            "normalizedIdentical": { "type": "boolean" },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["old", "new"],
                "properties": {
                  "old": { "$ref": "#/$defs/text" },
                  "new": { "$ref": "#/$defs/text" }
                }
              }
            }
          }
        },
        "guards": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family"],
            "properties": {
              "family": { "$ref": "#/$defs/text" },
              "kind": { "enum": ["dependency", "feature", "capability", "owner"] },
              "path": { "$ref": "#/$defs/text" },
              "executedTests": { "$ref": "#/$defs/count" },
              "plantedFixture": { "$ref": "#/$defs/text" },
              "plantedRejected": { "type": "boolean" }
            }
          }
        },
        "formatInventories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "updated"],
            "properties": {
              "id": { "$ref": "#/$defs/text" },
              "updated": { "type": "boolean" }
            }
          }
        },
        "futureCharterSurfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface", "owner"],
            "properties": {
              "surface": { "$ref": "#/$defs/text" },
              "owner": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    },
    "observeInventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner", "path"],
            "properties": {
              "owner": { "$ref": "#/$defs/text" },
              "path": { "$ref": "#/$defs/text" },
              "rows": { "type": "array", "items": { "$ref": "#/$defs/observeRow" } }
            }
          }
        },
        "counts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/$defs/text" },
              "accessor": { "$ref": "#/$defs/text" },
              "availableWithCaptureOff": { "type": "boolean" }
            }
          }
        },
        "offVersusStripped": { "$ref": "#/$defs/text" }
      }
    },
    "observeRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item"],
      "properties": {
        "item": { "$ref": "#/$defs/text" },
        "productionConsumer": { "$ref": "#/$defs/text" },
        "classification": {
          "enum": ["REQUIRED", "REQUIRED-budget", "REQUIRED-lifetime", "OPTIONAL"]
        },
        "lifetime": { "$ref": "#/$defs/text" },
        "ownerModule": { "$ref": "#/$defs/text" },
        "gate": { "$ref": "#/$defs/text" }
      }
    },
    "reuseInventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "class", "result", "reusedAs"],
            "properties": {
              "id": { "$ref": "#/$defs/text" },
              "class": {
                "enum": [
                  "CompleteFact",
                  "CertifiedDivergence",
                  "OperationRefusal",
                  "IsolatedRootLedgerRefusal",
                  "Never"
                ]
              },
              "result": { "enum": ["Complete", "Approximate", "Unavailable", "Refused"] },
              "reusedAs": { "enum": ["complete", "refusal", "none"] },
              "profileScoped": { "type": "boolean" },
              "isolatedRoot": { "type": "boolean" },
              "contextKeyed": { "type": "boolean" }
            }
          }
        },
        "negativeCacheTests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "test"],
            "properties": {
              "dimension": { "$ref": "#/$defs/text" },
              "test": { "$ref": "#/$defs/text" },
              "executedTests": { "$ref": "#/$defs/count" },
              "passed": { "type": "boolean" }
            }
          }
        },
        "perFactTransportExact": { "type": "boolean" },
        "unownedGraphEscapes": { "$ref": "#/$defs/count" }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "subject"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["deviation", "mismatch", "deferral", "waiver"] },
        "subject": { "$ref": "#/$defs/text" },
        "disposition": { "enum": ["accepted", "fixed", "rejected", "open"] },
        "rationale": { "$ref": "#/$defs/text" }
      }
    }
  }
}
