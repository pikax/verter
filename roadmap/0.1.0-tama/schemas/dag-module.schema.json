{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rev11 static DAG module",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "module", "node"],
  "properties": {
    "schema": { "const": 4 },
    "module": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "node": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  }
}
