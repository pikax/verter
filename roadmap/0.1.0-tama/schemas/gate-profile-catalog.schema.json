{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate profile catalog",
  "type": "object", "additionalProperties": false, "required": ["schema", "profile"],
  "properties": { "schema": { "const": 2 }, "profile": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "iteration", "final"], "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "iteration": { "type": "boolean" },
    "final": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  } } } }
}
