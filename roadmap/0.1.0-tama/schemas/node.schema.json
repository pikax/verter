{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rev11 static DAG node",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "predecessors",
    "phase",
    "train",
    "product",
    "kind",
    "semantic_role",
    "class",
    "owner",
    "conflict_domains",
    "resource_class",
    "gate_profile",
    "review_profile",
    "implementation_effort_min",
    "implementation_effort_default",
    "review_effort_min",
    "review_effort_default",
    "verification_effort_min",
    "verification_effort_default",
    "confirmation_effort_min",
    "confirmation_effort_default",
    "dispatchable",
    "optional",
    "release_gating",
    "external_requirements",
    "charter",
    "size",
    "max_production_loc",
    "max_production_files",
    "max_related_packages",
    "rescope_loc",
    "rescope_files",
    "rescope_unrelated_packages"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "predecessors": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" }
    },
    "phase": { "type": "string", "minLength": 1 },
    "train": { "type": "string", "minLength": 1 },
    "product": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "semantic_role": { "enum": ["delivery", "convergence", "history"] },
    "class": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "conflict_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "resource_class": { "type": "string", "minLength": 1 },
    "gate_profile": { "type": "string", "minLength": 1 },
    "review_profile": { "type": "string", "minLength": 1 },
    "implementation_effort_min": { "enum": ["low", "medium", "high"] },
    "implementation_effort_default": { "enum": ["low", "medium", "high"] },
    "review_effort_min": { "enum": ["low", "medium", "high"] },
    "review_effort_default": { "enum": ["low", "medium", "high"] },
    "verification_effort_min": { "enum": ["low", "medium", "high"] },
    "verification_effort_default": { "enum": ["low", "medium", "high"] },
    "confirmation_effort_min": { "enum": ["low", "medium", "high"] },
    "confirmation_effort_default": { "enum": ["low", "medium", "high"] },
    "dispatchable": { "type": "boolean" },
    "optional": { "type": "boolean" },
    "release_gating": { "type": "string", "minLength": 1 },
    "gh_milestone": { "type": "string", "minLength": 1 },
    "external_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "charter": { "type": "string", "pattern": "^charters/(?:[a-z0-9-]+/)+[A-Z][A-Z0-9-]*\\.md$" },
    "size": { "enum": ["S", "M", "L"] },
    "max_production_loc": { "type": "integer", "minimum": 0 },
    "max_production_files": { "type": "integer", "minimum": 0 },
    "max_related_packages": { "type": "integer", "minimum": 0 },
    "rescope_loc": { "type": "integer", "minimum": 0 },
    "rescope_files": { "type": "integer", "minimum": 0 },
    "rescope_unrelated_packages": { "type": "integer", "minimum": 0 }
  }
}
