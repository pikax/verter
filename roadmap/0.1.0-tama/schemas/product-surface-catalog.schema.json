{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public product-surface capability and performance catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product",
    "owner",
    "status",
    "lock_record",
    "baseline",
    "measurement",
    "surface",
    "controlling_row",
    "command",
    "advertised_entrypoint"
  ],
  "properties": {
    "schema": { "const": 1 },
    "product": { "const": "rev11" },
    "owner": { "const": "L0" },
    "status": { "const": "RATIFIED" },
    "lock_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "review_class",
        "extension_of",
        "never_weakens_locked_cells",
        "correction_rule"
      ],
      "properties": {
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "review_class": { "const": "architecture-3" },
        "extension_of": { "const": "performance-gates.toml" },
        "never_weakens_locked_cells": { "const": true },
        "correction_rule": { "type": "string", "minLength": 40 }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "lock_status",
        "baseline_sha",
        "baseline_tree",
        "runner_class",
        "runner_memory_bytes",
        "runner_logical_cpus",
        "rust_toolchain",
        "node_runtime",
        "published_release",
        "paired_frozen_dependency_rule",
        "invalid_historical_result_rule"
      ],
      "properties": {
        "source_file": { "type": "string", "minLength": 1 },
        "lock_status": { "const": "LOCKED" },
        "baseline_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "baseline_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "runner_class": { "type": "string", "minLength": 1 },
        "runner_memory_bytes": { "type": "integer", "minimum": 1 },
        "runner_logical_cpus": { "type": "integer", "minimum": 1 },
        "rust_toolchain": { "type": "string", "minLength": 1 },
        "node_runtime": { "type": "string", "minLength": 1 },
        "published_release": { "type": "string", "minLength": 1 },
        "paired_frozen_dependency_rule": { "type": "string", "minLength": 40 },
        "invalid_historical_result_rule": { "type": "string", "minLength": 40 }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rss_statistic",
        "rss_scope",
        "rss_includes_allocator_overhead",
        "allocator_slack_bytes",
        "owned_bytes_scope",
        "owned_bytes_excludes_allocator_overhead",
        "no_regression_floor_milli_percent",
        "statistical_zero_bound_rule",
        "cross_release_comparison"
      ],
      "properties": {
        "rss_statistic": { "const": "max" },
        "rss_scope": { "type": "string", "minLength": 20 },
        "rss_includes_allocator_overhead": { "const": true },
        "allocator_slack_bytes": { "type": "integer", "minimum": 1 },
        "owned_bytes_scope": { "type": "string", "minLength": 20 },
        "owned_bytes_excludes_allocator_overhead": { "const": true },
        "no_regression_floor_milli_percent": { "type": "integer", "minimum": 1 },
        "statistical_zero_bound_rule": { "type": "string", "minLength": 40 },
        "cross_release_comparison": { "type": "string", "minLength": 40 }
      }
    },
    "surface": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "public_consumer",
          "documented_entrypoint",
          "stability_class",
          "owning_terminal",
          "command_id",
          "corpus",
          "build_prerequisites",
          "fixture_prerequisites",
          "lane"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
          "public_consumer": { "type": "string", "minLength": 1 },
          "documented_entrypoint": { "type": "string", "minLength": 1 },
          "stability_class": {
            "enum": ["stable", "preview", "experimental-unranked"]
          },
          "owning_terminal": { "type": "string", "minLength": 1 },
          "removing_node": { "type": "string", "minLength": 1 },
          "replacement_slo": { "type": "string", "minLength": 20 },
          "command_id": { "type": "string", "minLength": 1 },
          "corpus": { "type": "string", "minLength": 1 },
          "build_prerequisites": { "type": "string", "minLength": 1 },
          "fixture_prerequisites": { "type": "string", "minLength": 1 },
          "lane": { "enum": ["local", "ci"] }
        }
      }
    },
    "controlling_row": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "surface_id",
          "kind",
          "metric",
          "statistic",
          "comparison",
          "limit",
          "source",
          "method"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "surface_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["wall", "allocation", "process_tree_rss"] },
          "metric": { "type": "string", "minLength": 1 },
          "statistic": { "enum": ["median", "max"] },
          "comparison": {
            "enum": ["absolute_max", "no_regression_milli_percent"]
          },
          "limit": { "type": "integer", "minimum": 1 },
          "source": { "enum": ["performance-gates", "catalog-extension"] },
          "cell_id": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "minLength": 20 },
          "derivation": { "type": "string", "minLength": 20 }
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "command", "lane", "bound"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["validate", "negative_control", "build", "run"]
          },
          "command": { "type": "string", "minLength": 1 },
          "lane": { "enum": ["required", "local", "unbound"] },
          "bound": { "type": "boolean" },
          "gate_profile": { "type": "string", "minLength": 1 },
          "ci_job": { "type": "string", "minLength": 1 },
          "ci_filter": { "type": "string", "minLength": 1 }
        }
      }
    },
    "advertised_entrypoint": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "needle", "surface_id"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "needle": { "type": "string", "minLength": 1 },
          "surface_id": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
