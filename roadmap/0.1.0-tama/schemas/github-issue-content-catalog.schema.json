{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub issue content catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "issue"],
  "properties": {
    "schema": { "const": 1 },
    "issue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "title", "problem", "expected_outcome", "acceptance"],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "problem": { "type": "string", "minLength": 1 },
          "expected_outcome": { "type": "string", "minLength": 1 },
          "acceptance": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1 }
          },
          "technical_context": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
